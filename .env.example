# ---------- Required ----------
# Public hostname of this install, no protocol (e.g. pharmacy.example.com).
APP_HOST=localhost
# http or https. Use http only when testing without TLS.
APP_PROTOCOL=https

# ---------- Secrets (auto-generated into storage/secrets.env on first boot) ----------
# Set these only if you want to manage them yourself. Losing the encryption keys
# makes patient data unreadable. Show generated values: bin/rails selfhost:show_secrets
# SECRET_KEY_BASE=
# JWT_SECRET_KEY=
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ---------- Database ----------
# Leave unset to use SQLite in the storage volume. Set for Postgres, e.g.
# DATABASE_URL=postgres://user:password@host:5432/rxterminal

# ---------- Email (without SMTP_ADDRESS, emails are only logged) ----------
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=login
# SMTP_ENABLE_STARTTLS=true
# Sender shown on emails.
# MAIL_FROM="My Pharmacy <no-reply@example.com>"

# ---------- Monitoring (optional) ----------
# SENTRY_DSN=

# ---------- Docker Compose ----------
# Profiles to start: https (Caddy + Let's Encrypt), backup (Litestream), postgres.
# COMPOSE_PROFILES=https,backup
# Port the app is published on (default 3000). With the https profile, bind to localhost:
# APP_PORT=3000
# APP_BIND=127.0.0.1

# ---------- Backup profile (Litestream, S3-compatible storage) ----------
# LITESTREAM_REPLICA_URL=s3://my-bucket/rxterminal
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# ---------- Postgres profile ----------
# POSTGRES_PASSWORD=choose-a-long-random-password
# DATABASE_URL=postgres://rxterminal:choose-a-long-random-password@postgres:5432/rxterminal
