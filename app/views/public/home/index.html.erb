<% content_for :head, portal_structured_data_tag %>

<%= render "public/shared/page_header", title: "Book an appointment" %>

<% if @services.any? %>
  <%= render "public/shared/service_picker", services: @services, kind: :appointment, storage_key: "portal_services_view" %>
<% else %>
  <p class="mt-6 text-sm text-base-content/60">No appointment services are currently available.</p>
<% end %>
