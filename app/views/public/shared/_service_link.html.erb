<%# locals: (service:, url:, searchable: false) %>
<%# Horizontal row. The picture (or icon) gets a larger box and is shown whole, never cropped or stretched. %>
<%= link_to url,
      class: "card border border-base-300 block",
      data: searchable ? { portal_search_target: "item", name: service.display_name } : {} do %>
  <div class="card-body flex-row items-center gap-4 p-4 sm:gap-5 sm:p-5">
    <% if service_image?(service) %>
      <div class="flex h-[5.25rem] w-[5.25rem] shrink-0 items-center justify-center sm:h-24 sm:w-24">
        <%= service_image_tag(service, width: 96, height: 96, fit: :limit, class: "h-auto w-auto max-h-full max-w-full object-contain") %>
      </div>
    <% elsif service.icon.present? %>
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
        <%= material_icon(service.icon, size: 26) %>
      </div>
    <% end %>

    <div class="min-w-0 flex-1">
      <p class="text-[1.0625rem] font-semibold"><%= service.display_name %></p>
      <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.9375rem] text-base-content/60">
        <span class="inline-flex items-center gap-1.5">
          <%= material_icon("schedule", size: 16) %>
          <%= service.estimated_duration %> min
        </span>
        <span class="inline-flex items-center gap-1.5">
          <%= material_icon("sell", size: 16) %>
          <%= portal_service_price_label(service) %>
        </span>
      </div>
      <% if service.description.present? %>
        <p class="mt-1.5 text-[0.9375rem] text-base-content/60"><%= truncate(service.description, length: 140) %></p>
      <% end %>
    </div>

    <%= material_icon("chevron_right", size: 24, class: "shrink-0 text-base-content/40") %>
  </div>
<% end %>
