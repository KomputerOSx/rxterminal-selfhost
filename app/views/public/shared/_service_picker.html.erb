<%# locals: (services:, kind:, storage_key:) %>
<%# Search box with a list / 2-column switch, shared by the appointment and walk-in service pickers.
    kind is :appointment or :walk_in. The chosen layout is remembered in the browser. %>
<%
  url_for_service = ->(service) {
    kind == :walk_in ? new_portal_walk_in_path(service_id: service.id) : new_portal_appointment_path(service_id: service.id)
  }
%>
<div data-controller="portal-search view-toggle" data-view-toggle-storage-key-value="<%= storage_key %>">
  <div class="mt-6 flex flex-row items-center gap-3">
    <div class="form-control min-w-0 flex-1">
      <input type="search"
             data-portal-search-target="input"
             data-action="input->portal-search#filter"
             aria-label="Search services"
             placeholder="Search services..."
             class="input-field w-full">
    </div>

    <div class="join shrink-0" role="group" aria-label="Layout">
      <button type="button"
              class="btn btn-outline btn-sm join-item gap-1"
              data-view-toggle-target="button"
              data-view-toggle-mode-param="list"
              data-action="click->view-toggle#select"
              aria-label="List view"
              title="List view">
        <%= material_icon("view_list", size: 18) %>
      </button>
      <button type="button"
              class="btn btn-outline btn-sm join-item gap-1"
              data-view-toggle-target="button"
              data-view-toggle-mode-param="card"
              data-action="click->view-toggle#select"
              aria-label="Two-column view"
              title="Two-column view">
        <%= material_icon("grid_view", size: 18) %>
      </button>
    </div>
  </div>

  <div class="mt-3 space-y-3" data-view-toggle-target="panel" data-view-toggle-mode="list">
    <% services.each do |service| %>
      <%= render "public/shared/service_link", service: service, url: url_for_service.call(service), searchable: true %>
    <% end %>
  </div>

  <div class="mt-3 grid grid-cols-2 gap-3" data-view-toggle-target="panel" data-view-toggle-mode="card">
    <% services.each do |service| %>
      <%= render "public/shared/service_card", service: service, url: url_for_service.call(service), searchable: true %>
    <% end %>
  </div>

  <p data-portal-search-target="empty" class="hidden mt-6 py-10 text-center text-sm text-base-content/60">
    No services match your search.
  </p>
</div>
