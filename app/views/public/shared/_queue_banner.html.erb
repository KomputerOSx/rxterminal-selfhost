<%# locals: (number:, label: "Queue number", subtitle: nil) %>
<div class="card border border-primary bg-primary text-primary-content">
  <div class="card-body items-center py-8 text-center">
    <p class="text-xs font-semibold uppercase tracking-widest opacity-80"><%= label %></p>
    <p class="mt-2 text-6xl font-bold leading-none"><%= number %></p>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-3 text-sm opacity-80"><%= subtitle %></p>
    <% end %>
  </div>
</div>
