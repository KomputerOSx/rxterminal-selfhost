<div class="text-center">
  <%= render "public/shared/status_icon", icon: "event", tone: "info" %>
  <h1 class="text-2xl font-semibold">Appointment is not today</h1>
</div>

<% if @appointment_date %>
  <div class="card mt-6 border border-base-300">
    <div class="card-body items-center text-center">
      <p class="text-sm text-base-content/60">Scheduled for</p>
      <p class="mt-1 text-lg font-semibold"><%= @appointment_date.strftime("%A, %-d %B %Y") %></p>
    </div>
  </div>
<% end %>

<div class="mt-8 text-center">
  <%= link_to "Back", portal_arrive_path, class: "btn btn-outline btn-sm" %>
</div>
