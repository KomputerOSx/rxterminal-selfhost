<% content_for :title, "#{LegalDocument.title("terms")} - #{@organization.name}" %>
<div class="card border border-base-300">
  <div class="card-body gap-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <h1 class="text-2xl font-semibold"><%= LegalDocument.title("terms") %></h1>
      <%= link_to "Back", portal_back_path, class: "btn btn-outline btn-sm" %>
    </div>
    <div class="legal-content text-sm text-base-content/80">
      <%= LegalDocument.render("terms", organization: @organization) %>
    </div>
  </div>
</div>
