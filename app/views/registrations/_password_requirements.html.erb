<div class="mt-2 rounded-lg border border-base-300/60 bg-base-100/50 px-2.5 py-2">
  <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-wide text-base-content/40">Password requirements</p>
  <ul class="flex flex-wrap gap-1.5">
    <% PasswordRequirements.signup_requirements.each do |requirement| %>
      <li class="inline-flex items-center gap-1 rounded-full border border-base-300/70 px-2 py-0.5 text-[11px] leading-tight text-base-content/45 transition-colors"
          data-password-requirements-target="item"
          data-requirement="<%= requirement.key %>">
        <span class="material-symbols-outlined shrink-0 !text-[12px]" data-icon>radio_button_unchecked</span>
        <span><%= requirement.label %></span>
      </li>
    <% end %>
  </ul>
</div>
