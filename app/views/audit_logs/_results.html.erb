<%# locals: (path_prefix:, results_frame:, show_organization_columns: false) %>
<% if @filters_applied %>
  <% if @matched_users.any? %>
    <div class="alert mt-6 border border-base-300 bg-base-200/40">
      <span class="text-sm text-base-content/60">Filtering by user:</span>
      <div class="flex flex-wrap gap-2">
        <% @matched_users.each do |user| %>
          <span class="badge badge-outline badge-sm font-mono"><%= user.email %> (#<%= user.id %>)</span>
        <% end %>
      </div>
    </div>
  <% elsif @filter_params[:user_search].present? %>
    <div class="alert alert-warning mt-6 py-2 text-sm">
      No users matched "<%= @filter_params[:user_search] %>".
    </div>
  <% end %>

  <div class="card mt-6 border border-base-300">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead class="bg-base-200 text-sm font-semibold text-base-content">
            <tr class="border-b border-base-300">
              <th>
                <%= sort_link("Time (UTC)", "created_at", current_sort: @sort_column, current_dir: @sort_direction, turbo_frame: results_frame) %>
              </th>
              <th>
                <%= sort_link("Event", "event_type", current_sort: @sort_column, current_dir: @sort_direction, turbo_frame: results_frame) %>
              </th>
              <th>User</th>
              <% if show_organization_columns %>
                <th>Org slug</th>
                <th>Org ID</th>
              <% end %>
              <th>Resource</th>
              <th>
                <%= sort_link("IP", "ip_address", current_sort: @sort_column, current_dir: @sort_direction, turbo_frame: results_frame) %>
              </th>
              <th>When</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @audit_logs.each do |log| %>
              <tr class="hover:bg-base-200">
                <td class="whitespace-nowrap">
                  <div class="font-mono text-xs"><%= log.created_at.strftime("%d %b %Y") %></div>
                  <div class="font-mono text-xs text-base-content/50"><%= log.created_at.strftime("%H:%M:%S") %></div>
                </td>
                <td class="font-medium"><%= log.event_type&.humanize || "Unknown" %></td>
                <td>
                  <% if log.user %>
                    <div class="text-sm"><%= log.user.email %></div>
                    <div class="text-xs text-base-content/50">#<%= log.user_id %></div>
                  <% else %>
                    <span class="text-base-content/50">-</span>
                  <% end %>
                </td>
                <% if show_organization_columns %>
                  <td class="font-mono text-xs text-base-content/80"><%= audit_log_organization_label(log) %></td>
                  <td class="font-mono text-xs text-base-content/60"><%= audit_log_organization_id_label(log) %></td>
                <% end %>
                <td>
                  <% if log.resource_type.present? %>
                    <%= link_to public_send(:"#{path_prefix}_audit_logs_path", audit_log_resource_filter_params(log, request.query_parameters)),
                          class: "font-mono text-xs link link-primary whitespace-nowrap",
                          data: { turbo_frame: "_top" } do %>
                      <%= log.resource_type %> #<%= log.resource_id %>
                    <% end %>
                  <% else %>
                    <span class="text-base-content/50">-</span>
                  <% end %>
                </td>
                <td class="font-mono text-xs text-base-content/60"><%= log.ip_address.presence || "-" %></td>
                <td class="text-base-content/60"><%= audit_log_time_ago(log.created_at) %></td>
                <td>
                  <div class="flex justify-end">
                    <%= link_to public_send(:"#{path_prefix}_audit_log_path", log, return_to: request.fullpath),
                          class: "btn btn-ghost btn-xs btn-square",
                          data: { turbo_frame: "_top", tip: "View" },
                          aria: { label: "View" } do %>
                      <span class="material-symbols-outlined !text-[18px]">visibility</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% if @audit_logs.none? %>
          <div class="px-8 py-16 text-center">
            <span class="material-symbols-outlined text-base-content/30 !text-[48px]">search</span>
            <h3 class="mt-3 font-semibold">No results</h3>
            <p class="mt-1 text-sm text-base-content/60">Try broadening your filters.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "shared/pagination",
        collection: @audit_logs,
        collection_name: "audit logs",
        turbo_frame: results_frame %>
<% else %>
  <div class="py-24 text-center text-base-content/40">
    <span class="material-symbols-outlined !text-[96px]">shield</span>
    <h3 class="mt-4 text-2xl font-semibold text-base-content/70">No filters applied</h3>
    <p class="mt-2 text-sm">Select at least one filter above and click Search audit logs.</p>
  </div>
<% end %>
