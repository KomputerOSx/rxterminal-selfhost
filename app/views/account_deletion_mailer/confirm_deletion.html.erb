<h1 style="margin:0 0 8px;font-size:28px;font-weight:400;color:<%= MailerTheme::HEADING_TEXT %>;line-height:1.2;">
  Confirm account deletion
</h1>

<p style="margin:0 0 24px;font-size:15px;color:<%= MailerTheme::BODY_TEXT %>;">
  We received a request to permanently delete the account for
  <strong style="color:<%= MailerTheme::HEADING_TEXT %>;"><%= @user.email %></strong>.
</p>

<div style="margin-bottom:24px;">
  <%= render "shared/mailer/code_card", code: @code, label: "Confirmation code" %>
</div>

<p style="margin:0;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;">
  Enter this code on the deletion confirmation screen. It expires in 30 minutes.
</p>

<p style="margin:16px 0 0;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;">
  If you did not request account deletion, ignore this email. Your account will not be deleted unless you complete the confirmation.
</p>
