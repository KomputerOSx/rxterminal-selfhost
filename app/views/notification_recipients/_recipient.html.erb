<li id="<%= dom_id(recipient) %>" class="py-4 flex items-start justify-between gap-4">
  <div class="min-w-0">
    <div class="flex items-center gap-2">
      <p class="font-medium"><%= recipient.notification.title %></p>
      <% if recipient.read_at.nil? %>
        <span class="badge badge-primary badge-xs">New</span>
      <% end %>
    </div>
    <p class="mt-1 text-sm text-base-content/70"><%= recipient.notification.body %></p>
    <% if recipient.notification.details.present? %>
      <dl class="mt-2 divide-y divide-base-300 rounded-box border border-base-300 text-sm">
        <% recipient.notification.details.each do |label, value| %>
          <div class="flex items-center justify-between gap-4 px-3 py-2">
            <dt class="text-xs uppercase tracking-wide text-base-content/60"><%= label %></dt>
            <dd class="font-medium break-all text-right"><%= value.presence || "Unknown" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
    <p class="mt-1 text-xs text-base-content/50"><%= time_ago_in_words(recipient.notification.created_at) %> ago</p>
  </div>
  <div class="flex flex-none gap-2">
    <% if recipient.notification.url.present? %>
      <%= link_to "View", open_notification_recipient_path(recipient), class: "btn btn-xs btn-primary btn-outline" %>
    <% end %>
    <% if recipient.read_at.nil? %>
      <%= button_to "Mark read", mark_read_notification_recipient_path(recipient), method: :patch, class: "btn btn-xs btn-outline" %>
    <% end %>
    <%= button_to "Delete", notification_recipient_path(recipient), method: :delete,
          params: { page: params[:page] }, class: "btn btn-xs btn-error btn-outline" %>
  </div>
</li>
