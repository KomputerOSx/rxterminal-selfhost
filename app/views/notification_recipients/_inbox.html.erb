<div id="notifications_inbox">
  <div class="flex items-center justify-between mb-4">
    <h2 class="card-title text-xl font-semibold">Inbox</h2>
    <% if current_user.unread_notification_count > 0 %>
      <%= button_to "Mark all read", mark_all_read_notification_recipients_path, method: :patch,
            params: { page: params[:page] }, class: "btn btn-xs btn-outline" %>
    <% end %>
  </div>

  <% if notification_recipients.any? %>
    <ul class="divide-y divide-base-300/30">
      <%= render partial: "notification_recipients/recipient", collection: notification_recipients, as: :recipient %>
    </ul>

    <%= render "shared/pagination", collection: notification_recipients, collection_name: "notifications" %>
  <% else %>
    <p class="text-base-content/60 text-sm">No notifications.</p>
  <% end %>
</div>
