<%# locals: (plan_usage:, currency:, current_plan:) %>
<div class="card mt-4 border border-base-300">
  <div class="card-body p-0">
    <div class="border-b border-base-300 px-8 py-4">
      <h3 class="text-sm font-semibold">Plan usage</h3>
    </div>

    <dl class="divide-y divide-base-300">
      <% plan_usage.each do |item| %>
        <div class="flex items-start justify-between gap-4 px-8 py-3">
          <dt class="text-sm text-base-content"><%= item.label %></dt>
          <dd class="shrink-0 text-right text-sm">
            <% case item.kind %>
            <% when :count %>
              <% if item.limit %>
                <span class="<%= item.at_limit ? "font-medium text-warning" : "text-base-content/80" %>">
                  <%= item.used %> of <%= item.limit %>
                </span>
                <% if item.at_limit %>
                  <span class="mt-0.5 block text-xs text-warning">At plan limit</span>
                <% end %>
              <% else %>
                <span class="text-base-content/80"><%= number_with_delimiter(item.used) %> · unlimited</span>
              <% end %>
            <% when :feature %>
              <% if item.enabled %>
                <span class="badge badge-success badge-sm">Included</span>
              <% else %>
                <span class="badge badge-ghost badge-sm">Not included</span>
              <% end %>
            <% when :retention %>
              <span class="text-base-content/80"><%= item.value_label %></span>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
