<% content_for :title, "Plan setup" %>

<section class="w-full max-w-2xl">
  <p class="text-sm font-medium text-base-content/60">Billing</p>
  <h1 class="mt-3 text-2xl font-semibold">Set up Starter</h1>

  <% if @mode == :scheduled %>
    <div class="card mt-6 border border-info/40 bg-info/10">
      <div class="card-body flex-row items-center gap-3 py-4">
        <span class="material-symbols-outlined text-info">info</span>
        <p class="text-sm">You'll keep full Business access until the scheduled downgrade takes effect.</p>
      </div>
    </div>
  <% end %>

  <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-base-content/60">
    <% @wizard.required_steps.each_with_index do |step, index| %>
      <span class="<%= step == @step ? "font-semibold text-primary" : "" %>"><%= index + 1 %>. <%= @wizard.step_label(step) %></span>
      <% unless index == @wizard.required_steps.length - 1 %>
        <span>·</span>
      <% end %>
    <% end %>
  </div>

  <div class="card mt-4 border border-base-300">
    <div class="card-body">
      <%= render "billing/plan_reconciliation/#{@step}",
            wizard: @wizard,
            step: @step,
            organization: @organization,
            target_plan: @target_plan,
            mode: @mode %>
    </div>
  </div>
</section>
