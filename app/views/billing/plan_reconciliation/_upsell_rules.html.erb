<h2 class="text-lg font-semibold">Upsell rules</h2>

<% rules = wizard.selectable_upsell_rules %>
<%= form_with url: billing_plan_reconciliation_path,
      method: :patch,
      class: "mt-4",
      data: (upsell_rule_options_filter_enabled?(rules.size) ? { controller: "options-filter" } : {}) do %>
  <%= hidden_field_tag :step, :upsell_rules %>
  <% if upsell_rule_options_filter_enabled?(rules.size) %>
    <%= render "shared/options_filter_search", label: "Search rules" %>
  <% end %>
  <div class="mt-4 space-y-2 max-h-64 overflow-y-auto">
    <% rules.each do |rule| %>
      <label class="flex items-center gap-3 rounded-lg border border-base-300 px-3 py-2 text-sm"
             <%= tag.attributes(data: { options_filter_target: "item", label: rule.name }) if upsell_rule_options_filter_enabled?(rules.size) %>>
        <%= radio_button_tag :upsell_rule_id, rule.id, wizard.choices["upsell_rule_id"].to_i == rule.id, class: "radio-field" %>
        <span><%= rule.name %></span>
      </label>
    <% end %>
  </div>
  <%= render "billing/plan_reconciliation/step_actions",
        wizard: wizard,
        step: step,
        class: "mt-4",
        continue: button_tag("Continue", class: "btn btn-primary btn-sm") %>
<% end %>
