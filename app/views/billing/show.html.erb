<section class="w-full max-w-3xl" data-controller="processing-overlay">
  <dialog data-processing-overlay-target="overlay" class="modal">
    <div class="flex items-center gap-3 rounded-lg border border-base-300 bg-base-100 px-6 py-4">
      <span class="loading loading-spinner loading-md"></span>
      <span class="text-sm font-medium">Processing your request...</span>
    </div>
  </dialog>

  <p class="text-sm font-medium text-base-content/60">Organization</p>
  <h1 class="mt-3 text-2xl font-semibold">Billing</h1>

  <% if Current.organization.over_member_limit? %>
    <div class="card mt-6 border border-warning/40 bg-warning/10">
      <div class="card-body flex-row items-center gap-3 py-4">
        <span class="material-symbols-outlined text-warning">warning</span>
        <p class="text-sm text-base-content">
          This organization is over its <%= @current_plan&.name || Billing::Plans::STARTER.name %> plan's member limit. Remove members or upgrade to keep inviting people.
        </p>
      </div>
    </div>
  <% elsif Current.organization.locked? %>
    <div class="card mt-6 border border-error/40 bg-error/10">
      <div class="card-body flex-row items-center gap-3 py-4">
        <span class="material-symbols-outlined text-error">lock</span>
        <p class="text-sm text-base-content">
          This organization's subscription has ended. Choose a plan below to restore queue, appointments, and customer-facing features.
        </p>
      </div>
    </div>
  <% end %>

  <%# ── Current Plan ── %>
  <div class="mt-10">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-lg font-semibold">Current plan</h2>

      <div class="flex shrink-0 items-center gap-2">
        <span class="badge badge-outline badge-sm"><%= billing_currency_badge %></span>
      </div>
    </div>

    <%# ── Subscription status notices ── %>
    <% period_end_copy = @current_period_end&.to_date&.to_fs(:long) || "the end of your current billing period" %>
    <% if @on_grace_period %>
      <div class="card mt-4 border border-warning/40 bg-warning/10">
        <div class="card-body flex-row items-center justify-between gap-3 py-4">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-warning">schedule</span>
            <p class="text-sm">
              Your <%= @current_plan.name %> plan is cancelled and ends on
              <strong><%= @subscription.ends_at&.to_date&.to_fs(:long) || "your period end date" %></strong>.
              You keep full access until then.
            </p>
          </div>
          <%= button_to "Resume subscription", billing_subscription_resume_path, method: :post,
                class: "btn btn-primary btn-sm shrink-0", data: { controller: "loading-button" } %>
        </div>
      </div>
    <% elsif @pending_plan && @current_plan %>
      <div class="card mt-4 border border-info/40 bg-info/10">
        <div class="card-body flex-row items-center justify-between gap-3 py-4">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-info">schedule</span>
            <p class="text-sm">
              Your plan changes to <strong><%= @pending_plan.name %>
              (<%= @pending_plan.formatted_price(@currency) %>/mo)</strong> on
              <strong><%= Current.organization.pending_plan_change_at&.to_date&.to_fs(:long) || "your next billing date" %></strong>.
              Until then you keep everything in <%= @current_plan.name %>.
            </p>
          </div>
          <%= button_to "Keep current plan", billing_subscription_scheduled_change_path, method: :delete,
                class: "btn btn-outline btn-sm shrink-0", data: { controller: "loading-button" } %>
        </div>
      </div>
    <% elsif @pending_price_cents && @current_plan %>
      <div class="card mt-4 border border-warning/40 bg-warning/10">
        <div class="card-body flex-row items-center gap-3 py-4">
          <span class="material-symbols-outlined text-warning">trending_up</span>
          <p class="text-sm">
            Heads up - your <%= @current_plan.name %> price is changing to
            <strong><%= Pay::Currency.format(@pending_price_cents, currency: @currency) %>/mo</strong> on
            <strong><%= Current.organization.pending_plan_change_at&.to_date&.to_fs(:long) || "your next billing date" %></strong>.
          </p>
        </div>
      </div>
    <% elsif @on_trial %>
      <div class="card mt-4 border border-info/40 bg-info/10">
        <div class="card-body flex-row items-center gap-3 py-4">
          <span class="material-symbols-outlined text-info">hourglass_top</span>
          <p class="text-sm">
            <% if @subscribed %>
              Free trial - your card will be charged when the trial ends unless you cancel first.
            <% else %>
              <%= Organization::TRIAL_DAYS %>-day free trial.
              <% if Current.organization.trial_ends_at %>
                Ends on <strong><%= Current.organization.trial_ends_at.to_date.to_fs(:long) %></strong>.
              <% end %>
              Subscribe to an available plan to maintain access.
            <% end %>
          </p>
        </div>
      </div>
    <% elsif Current.organization.grandfathered? && @subscribed %>
      <div class="card mt-4 border border-success/40 bg-success/10">
        <div class="card-body flex-row items-center gap-3 py-4">
          <span class="material-symbols-outlined text-success">loyalty</span>
          <p class="text-sm text-base-content">
            <strong>Legacy Pricing:</strong> You are grandfathered into an older price!
            Your <%= @current_plan.name %> rate is locked in and unaffected by recent price increases.
          </p>
        </div>
      </div>
    <% end %>

    <%# ── Next bill ── %>
    <%= render "billing/next_bill" %>

    <%# ── Current Plan Summary Card ── %>
    <div class="card mt-4 border border-base-300">
      <div class="card-body p-0">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between px-8 py-5 gap-4">
          <div>
            <p class="text-2xl font-semibold"><%= @current_plan&.name || "No active plan" %></p>
            <% if @current_plan %>
              <p class="mt-1 text-sm text-base-content/60">
                <%= @current_plan.formatted_price(@currency) %>
                <span><%= billing_monthly_price_suffix %></span>
              </p>
            <% end %>
          </div>
          <div class="shrink-0">
            <button onclick="document.getElementById('change_plan_dialog').showModal()" class="btn btn-outline btn-sm">
              <%= @subscribed ? "Change plan" : "Choose a plan" %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <%= render "billing/plan_usage", plan_usage: @plan_usage, currency: @currency, current_plan: @current_plan %>

    <%# ── Promo code ── %>
    <% unless @on_grace_period %>
      <div class="mt-4">
        <%= render "billing/promo_code_widget", promo_code_id: @promo_code_id, promo_code_display: @promo_code_display %>
      </div>
    <% end %>

    <%# ── Change Plan Modal (Grid) ── %>
    <dialog id="change_plan_dialog" class="modal">
      <div class="modal-box w-11/12 max-w-5xl">
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        <h3 class="text-lg font-semibold mb-6">Select a plan</h3>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <% @plans.each do |plan| %>
            <div class="card border <%= plan == @current_plan ? "border-primary" : "border-base-300" %>">
              <div class="card-body flex flex-col">
                <div class="flex items-center justify-between">
                  <h4 class="font-semibold"><%= plan.name %></h4>
                  <% if plan == @current_plan %>
                    <span class="badge badge-primary badge-sm">Current</span>
                  <% end %>
                </div>
                <p class="mt-1 text-2xl font-semibold">
                  <%= plan.formatted_price(@currency) %>
                  <span class="text-sm font-normal text-base-content/60"><%= billing_monthly_price_suffix %></span>
                </p>

                <div class="mt-4">
                  <% if plan == @current_plan %>
                    <% if @on_trial && !@subscribed %>
                      <%= button_to "Subscribe", billing_checkout_session_path(plan: plan.key), method: :post,
                            class: "btn btn-primary btn-sm w-full",
                            data: { turbo: false, controller: "loading-button" } %>
                    <% end %>
                  <% elsif @on_grace_period %>
                    <%# Plan changes are locked while cancelled - resume first (banner above). %>
                    <span class="text-sm text-base-content/60">Resume your subscription to change plans.</span>
                  <% elsif @pending_plan == plan %>
                    <span class="badge badge-info badge-sm">
                      Scheduled for <%= Current.organization.pending_plan_change_at&.to_date&.to_fs(:long) || "next billing date" %>
                    </span>
                  <% else %>
                    <% upgrade = @subscribed && plan.price_cents(@currency) > @current_plan.price_cents(@currency) %>
                    <% on_local_trial = @on_trial && !@subscribed %>
                    <% label = if on_local_trial
                         "Subscribe"
                       elsif @subscribed
                         upgrade ? "Upgrade" : "Downgrade"
                       else
                         "Subscribe"
                       end %>
                    <% if on_local_trial && !@payment_method %>
                      <% confirm_message = "Switch to #{plan.name} for the rest of your trial? No payment is required until you choose to subscribe." %>
                      <%= button_to "Switch plan", billing_subscription_path(plan: plan.key), method: :post,
                            class: "btn btn-outline btn-sm w-full",
                            data: {
                              controller: "confirm-modal loading-button", action: "click->confirm-modal#confirm",
                              confirm_modal_message_value: confirm_message
                            } %>
                      <%= button_to label, billing_checkout_session_path(plan: plan.key), method: :post,
                            class: "btn btn-primary btn-sm mt-2 w-full",
                            data: { turbo: false, controller: "loading-button" } %>
                    <% elsif @subscribed && @payment_method %>
                      <% confirm_message =
                           if upgrade
                             if billing_collect_vat?
                               "Switch to #{plan.name} now? You'll be charged a prorated amount today (ex VAT + VAT), then #{plan.formatted_price(@currency)}/mo ex VAT from your next billing date."
                             else
                               "Switch to #{plan.name} now? You'll be charged a prorated amount today, then #{plan.formatted_price(@currency)}/mo from your next billing date."
                             end
                           elsif billing_collect_vat?
                             "Downgrade to #{plan.name}? You'll keep #{@current_plan.name} until #{period_end_copy} - from then you'll be charged #{plan.formatted_price(@currency)}/mo ex VAT plus VAT. You can undo this any time before it happens."
                           else
                             "Downgrade to #{plan.name}? You'll keep #{@current_plan.name} until #{period_end_copy} - from then you'll be charged #{plan.formatted_price(@currency)}/mo. You can undo this any time before it happens."
                           end %>
                      <%= button_to label, billing_subscription_path(plan: plan.key), method: :post,
                            class: "btn btn-primary btn-sm w-full",
                            data: {
                              controller: "confirm-modal loading-button", action: "click->confirm-modal#confirm",
                              confirm_modal_message_value: confirm_message
                            } %>
                    <% else %>
                      <%= button_to label, billing_checkout_session_path(plan: plan.key), method: :post,
                            class: "btn btn-primary btn-sm w-full",
                            data: { turbo: false, controller: "loading-button" } %>
                    <% end %>
                  <% end %>
                </div>

                <div class="mt-4 border-t border-base-300 pt-4">
                  <p class="text-sm font-semibold text-base-content">What you get</p>
                  <ul class="mt-2 space-y-1.5">
                    <% marketing_plan_features(plan).each do |feature| %>
                      <li class="flex items-start gap-2 text-sm text-base-content/70">
                        <span class="material-symbols-outlined shrink-0 text-base text-success">check</span>
                        <span><%= feature %></span>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>
  </div>

  <% if @subscribed || @payment_method %>
    <div class="mt-10">
      <h2 class="text-lg font-semibold">Payment & billing details</h2>
      <%= button_to "Manage in Stripe", billing_billing_portal_session_path, method: :post,
            class: "btn btn-outline btn-sm mt-4", data: { turbo: false, controller: "loading-button" } %>
    </div>
  <% end %>

  <%# ── Billing History ── %>
  <div class="mt-10" id="billing-history">
    <h2 class="text-lg font-semibold">Billing history</h2>

    <% if @charges.present? %>
      <div class="card mt-4 border border-base-300">
        <div class="card-body p-0">
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead class="text-sm font-semibold text-base-content bg-base-200">
                <tr class="border-b border-base-300">
                  <th>Date</th>
                  <th>Amount</th>
                  <th>Charged to</th>
                  <th class="text-right">Invoice</th>
                </tr>
              </thead>
              <tbody>
                <% @charges.each do |charge| %>
                  <tr class="hover:bg-base-200">
                    <td class="text-base-content/60"><%= charge.created_at.strftime("%b %-d, %Y") %></td>
                    <td class="font-medium">
                      <%= charge.amount_with_currency %>
                      <% if charge.amount_refunded.to_i > 0 %>
                        <span class="badge badge-warning badge-sm ml-1">
                          <%= charge.amount_refunded.to_i >= charge.amount.to_i ? "Refunded" : "Partially refunded" %>
                        </span>
                      <% end %>
                    </td>
                    <td class="text-base-content/60"><%= charge.charged_to %></td>
                    <td class="text-right">
                      <% invoice_pdf = charge.stripe_invoice.is_a?(Hash) ? charge.stripe_invoice["invoice_pdf"] : nil %>
                      <% download_url = invoice_pdf || charge.stripe_receipt_url %>
                      <% if download_url %>
                        <%= link_to "Download", download_url, class: "link link-hover text-sm", target: "_blank", rel: "noopener" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <% if @charges_total_pages > 1 %>
        <div class="mt-3 flex items-center justify-between">
          <p class="text-sm text-base-content/60">Page <%= @charges_page %> of <%= @charges_total_pages %></p>
          <div class="join">
            <% if @charges_page > 1 %>
              <%= link_to "Previous", billing_path(charges_page: @charges_page - 1, anchor: "billing-history"), class: "btn btn-outline btn-sm join-item" %>
            <% else %>
              <button class="btn btn-outline btn-sm join-item" disabled>Previous</button>
            <% end %>
            <% if @charges_page < @charges_total_pages %>
              <%= link_to "Next", billing_path(charges_page: @charges_page + 1, anchor: "billing-history"), class: "btn btn-outline btn-sm join-item" %>
            <% else %>
              <button class="btn btn-outline btn-sm join-item" disabled>Next</button>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="mt-4 text-sm text-base-content/60">No invoices yet.</p>
    <% end %>
  </div>

  <%# ── Cancel subscription / end trial ── %>
  <% if @on_trial && !@subscribed %>
    <div class="mt-10">
      <h2 class="text-lg font-semibold">End trial</h2>
      <%= button_to "End trial", billing_subscription_path, method: :delete,
            class: "btn btn-error btn-outline btn-sm mt-4",
            data: {
              controller: "confirm-modal loading-button", action: "click->confirm-modal#confirm",
              confirm_modal_message_value: "End your #{@current_plan.name} trial now? This organization will be locked until you subscribe."
            } %>
    </div>
  <% elsif @subscribed && !@on_grace_period %>
    <div class="mt-10">
      <h2 class="text-lg font-semibold">Cancel subscription</h2>
      <%= button_to "Cancel subscription", billing_subscription_path, method: :delete,
            class: "btn btn-error btn-outline btn-sm mt-4",
            data: {
              controller: "confirm-modal loading-button", action: "click->confirm-modal#confirm",
              confirm_modal_message_value: "Cancel your #{@current_plan.name} subscription? You'll keep access until #{period_end_copy}, and you can resume any time before then."
            } %>
    </div>
  <% end %>
</section>
