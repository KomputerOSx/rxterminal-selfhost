<section class="w-full max-w-7xl">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold">Audit logs</h1>
    </div>
  </div>

  <%= form_with url: org_audit_logs_path,
        method: :get,
        data: {
          turbo_frame: "org_audit_logs_results_frame",
          controller: "audit-log-filters",
          audit_log_filters_min_from_value: ""
        },
        class: "mt-6" do %>
    <%= render "audit_logs/filter_panel",
          form_url: org_audit_logs_path,
          clear_url: org_audit_logs_path,
          results_frame: "org_audit_logs_results_frame",
          show_organization_filter: false %>
  <% end %>

  <%= turbo_frame_tag "org_audit_logs_results_frame", class: "mt-2 block" do %>
    <%= render "audit_logs/results",
          path_prefix: :org,
          results_frame: "org_audit_logs_results_frame",
          show_organization_columns: false %>
  <% end %>
</section>
