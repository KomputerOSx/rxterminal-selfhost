<section class="w-full max-w-3xl">
  <p class="text-sm font-medium text-base-content/60">
    <%= link_to "Upsell rules", org_upsell_rules_path, class: "hover:text-base-content" %>
    <span class="mx-1">/</span>
    <%= link_to @rule.name, org_upsell_rule_path(@rule), class: "hover:text-base-content" %>
    <span class="mx-1">/</span>
    <span>Edit</span>
  </p>

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold">Edit upsell rule</h1>
    <%= link_to "Back", org_upsell_rule_path(@rule), class: "btn btn-outline btn-sm" %>
  </div>

  <div class="mt-6">
    <%= render "form", rule: @rule, services: @services %>
  </div>
</section>
