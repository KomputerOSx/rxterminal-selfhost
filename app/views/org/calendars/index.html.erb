<section class="w-full max-w-5xl">

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold">Calendars</h1>

    <div class="flex flex-wrap gap-2">
      <%= link_to new_org_calendar_path, class: "btn btn-primary btn-sm gap-1" do %>
        <span class="material-symbols-outlined !text-[18px]">add</span>
        New calendar
      <% end %>
    </div>
  </div>

  <% if @calendars.any? %>
    <div class="card mt-6 border border-base-300">
      <div class="card-body p-0">
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead class="bg-base-200 text-sm font-semibold text-base-content">
              <tr class="border-b border-base-300">
                <th>Calendar</th>
                <th>Services</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @calendars.each do |calendar| %>
                <tr class="hover:bg-base-200 <%= 'opacity-60' if calendar.archived? %>">
                  <td>
                    <div class="flex items-center gap-3">
                      <%= calendar_color_dot(calendar, size: 14) %>
                      <div>
                        <div class="font-medium"><%= calendar.name %></div>
                        <% if calendar.is_default? %>
                          <span class="badge badge-primary badge-sm mt-1">Default</span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge badge-ghost badge-sm"><%= pluralize(calendar.services.count, "service") %></span>
                  </td>
                  <td>
                    <% if calendar.archived? %>
                      <span class="badge badge-ghost badge-sm">Archived</span>
                    <% else %>
                      <span class="badge badge-success badge-sm">Active</span>
                    <% end %>
                  </td>
                  <td>
                    <% unless calendar.archived? %>
                      <div class="flex justify-end gap-1">
                        <%= link_to edit_org_calendar_path(calendar),
                              class: "btn btn-ghost btn-xs btn-square",
                              title: "Edit" do %>
                          <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                        <% end %>
                        <% if calendar.archivable? %>
                          <%= button_to archive_org_calendar_path(calendar), method: :patch,
                                class: "btn btn-ghost btn-xs btn-square text-warning",
                                title: "Archive",
                                data: {
                                  controller: "confirm-modal",
                                  action: "click->confirm-modal#confirm",
                                  confirm_modal_message_value: "Archive \"#{calendar.name}\"? Its services will move to the default calendar."
                                } do %>
                            <span class="material-symbols-outlined" style="font-size:18px">inventory_2</span>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <p class="mt-6 text-sm text-base-content/60">No calendars yet.</p>
  <% end %>
</section>
