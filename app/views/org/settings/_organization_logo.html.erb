<div class="card border border-base-300">
  <div class="card-body gap-2 p-3">
    <div class="relative flex h-20 items-center justify-center overflow-hidden rounded-lg border border-base-300">
      <div class="flex h-full w-full items-center justify-center bg-base-100 p-2"
           data-theme="<%= kiosk_theme_for(organization_logo.organization) %>"
           style="<%= organization_logo.organization.kiosk_theme_inline_style %>">
        <%= image_tag organization_logo.image, class: "max-h-full max-w-full object-contain", alt: "Logo submission" %>
      </div>

      <% if can_manage %>
        <%= button_to org_organization_logo_path(organization_logo), method: :delete,
              class: "btn btn-ghost btn-xs btn-square text-error absolute right-1 top-1 bg-base-100",
              title: "Remove",
              data: {
                controller: "confirm-modal",
                action: "click->confirm-modal#confirm",
                confirm_modal_message_value: organization_logo.active? ? "Remove this logo? It's currently your active kiosk logo - the kiosk and portal will keep showing it until you activate or remove another one." : "Remove this logo submission?"
              } do %>
          <span class="material-symbols-outlined" style="font-size:18px">delete</span>
        <% end %>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-1">
      <% if organization_logo.pending? %>
        <span class="badge badge-warning badge-sm">Pending review</span>
      <% elsif organization_logo.approved? %>
        <span class="badge badge-success badge-sm">Approved</span>
      <% elsif organization_logo.declined? %>
        <span class="badge badge-error badge-sm">Declined</span>
      <% end %>
      <% if organization_logo.active? %>
        <span class="badge badge-primary badge-sm">Active</span>
      <% end %>
    </div>

    <p class="text-xs text-base-content/60"><%= organization_logo.created_at.strftime("%b %d, %Y") %></p>

    <% if organization_logo.declined? && organization_logo.decline_reason.present? %>
      <p class="text-xs text-error"><%= organization_logo.decline_reason %></p>
    <% end %>

    <% if can_manage && organization_logo.approved? && !organization_logo.active? %>
      <%= button_to "Use this logo", activate_org_organization_logo_path(organization_logo),
            method: :patch,
            class: "btn btn-outline btn-sm w-full" %>
    <% end %>
  </div>
</div>
