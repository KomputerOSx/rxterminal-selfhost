<% content_for :head do %>
  <script>
    window.addEventListener("load", () => window.print(), { once: true });
    window.addEventListener("DOMContentLoaded", () => {
      const printButton = document.getElementById("print-appointments-button");
      if (printButton) {
        printButton.addEventListener("click", () => window.print());
      }
    });
  </script>
<% end %>

<div class="max-w-7xl mx-auto px-3 py-3">
  <div class="print-hidden flex items-center justify-between gap-4 mb-3">
    <div>
      <h1 class="text-xl font-bold">Print Appointments</h1>
      <p class="text-xs text-base-content/50">Use your browser's Save as PDF option to export this day.</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="print-appointments-button" type="button" class="btn btn-sm btn-outline">
        Print / Save PDF
      </button>
      <%= link_to org_appointments_path(date: @date.iso8601, service_id: params[:service_id], calendar_id: params[:calendar_id]),
            class: "btn btn-sm btn-ghost" do %>
        Back
      <% end %>
    </div>
  </div>

  <div class="border-b border-base-300 pb-2 mb-3">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="text-[10px] uppercase tracking-[0.2em] text-base-content/50">Appointments</p>
        <h1 class="text-xl font-bold leading-tight"><%= Current.organization.name %></h1>
        <p class="text-sm mt-1"><%= @date.strftime("%A, %d %B %Y") %></p>
      </div>
      <div class="text-right text-[11px] text-base-content/60 space-y-0.5">
        <p>Total appointments: <span class="font-semibold text-base-content"><%= @appointments.count %></span></p>
        <% if @service %>
          <p>Service: <span class="font-semibold text-base-content"><%= @service.display_name %></span></p>
        <% end %>
        <% if @calendar %>
          <p>Calendar: <span class="font-semibold text-base-content"><%= @calendar.name %></span></p>
        <% end %>
        <p>Printed: <span class="font-semibold text-base-content"><%= Time.current.strftime("%d/%m/%Y %H:%M") %></span></p>
        <p>Printed by: <span class="font-semibold text-base-content"><%= [ current_user.first_name, current_user.last_name ].compact_blank.join(" ").presence || current_user.email %></span></p>
      </div>
    </div>
  </div>

  <% if @appointments.any? %>
    <table class="table-fixed border border-base-300 text-[10px] leading-tight">
      <thead>
        <tr class="bg-base-200">
          <th class="w-[7%] border border-base-300 px-1 py-1 text-left font-semibold">Time</th>
          <th class="w-[16%] border border-base-300 px-1 py-1 text-left font-semibold">Customer</th>
          <th class="w-[9%] border border-base-300 px-1 py-1 text-left font-semibold">DOB</th>
          <th class="w-[10%] border border-base-300 px-1 py-1 text-left font-semibold">Postcode</th>
          <th class="w-[12%] border border-base-300 px-1 py-1 text-left font-semibold">Service</th>
          <th class="w-[11%] border border-base-300 px-1 py-1 text-left font-semibold">Reference</th>
          <th class="w-[8%] border border-base-300 px-1 py-1 text-left font-semibold">Status</th>
          <th class="w-[14%] border border-base-300 px-1 py-1 text-left font-semibold">Email</th>
          <th class="w-[13%] border border-base-300 px-1 py-1 text-left font-semibold">Notes</th>
        </tr>
      </thead>
      <tbody>
        <% @appointments.each do |appt| %>
          <tr class="print-page-break">
            <td class="border border-base-300 px-1 py-1 font-semibold whitespace-nowrap"><%= appt.formatted_time %></td>
            <td class="border border-base-300 px-1 py-1">
              <div class="font-semibold leading-tight"><%= appt.last_name %>, <%= appt.first_name %></div>
              <% if appt.calendar.present? %>
                <div class="text-[9px] text-base-content/50 leading-tight"><%= appt.calendar.name %></div>
              <% end %>
            </td>
            <td class="border border-base-300 px-1 py-1 whitespace-nowrap"><%= appt.dob&.strftime("%d/%m/%Y") %></td>
            <td class="border border-base-300 px-1 py-1"><%= appt.postcode %></td>
            <td class="border border-base-300 px-1 py-1"><%= appt.service.display_name %></td>
            <td class="border border-base-300 px-1 py-1 font-semibold tracking-wide"><%= appt.booking_reference %></td>
            <td class="border border-base-300 px-1 py-1">
              <div><%= appt.status.humanize %></div>
              <% if appt.checked_in_at.present? %>
                <div class="text-[9px] text-base-content/50"><%= appt.checked_in_at.strftime("%H:%M") %></div>
              <% end %>
            </td>
            <td class="border border-base-300 px-1 py-1 break-all"><%= appt.email.presence || "-" %></td>
            <td class="border border-base-300 px-1 py-1 whitespace-pre-wrap break-words"><%= appt.notes.presence || "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="border border-dashed border-base-300 rounded-xl p-6 text-center text-sm text-base-content/50">
      No appointments found for this day and filter combination.
    </div>
  <% end %>
</div>
