<section class="w-full <%= @view == "day" ? "max-w-5xl" : "max-w-7xl" %>">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold">Appointments</h1>

    <div class="flex flex-wrap gap-2">
      <% if current_user.has_permission?("app.appointments.manage", organization: Current.organization) %>
        <%= link_to new_org_appointment_path(date: @date), class: "btn btn-primary btn-sm gap-1" do %>
          <span class="material-symbols-outlined !text-[18px]">add</span>
          New appointment
        <% end %>
      <% end %>
      <%= link_to print_org_appointments_path({ date: @date, calendar_id: @calendar&.id }.compact), target: "_blank", rel: "noopener", class: "btn btn-outline btn-sm gap-1" do %>
        <span class="material-symbols-outlined !text-[18px]">print</span>
        Print day
      <% end %>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <div class="relative min-w-[200px] max-w-sm flex-1"
         data-controller="appointment-search"
         data-appointment-search-url-value="<%= search_org_appointments_path(appointment_calendar_return_params.except(:date)) %>">
      <input type="search"
             placeholder="Search by name or booking reference"
             aria-label="Search by name or booking reference"
             class="input-field w-full"
             autocomplete="off"
             data-appointment-search-target="input"
             data-action="focus->appointment-search#query input->appointment-search#query">
      <div data-appointment-search-target="popover"
           class="absolute left-0 top-full z-40 mt-1 hidden w-full min-w-[22rem]">
        <div class="card border border-base-300 bg-base-100 shadow-none">
          <div class="card-body max-h-80 overflow-y-auto p-2"
               data-appointment-search-target="results"></div>
        </div>
      </div>
    </div>

    <div class="flex shrink-0 flex-wrap items-center gap-3">
      <div class="join" role="group" aria-label="Calendar view">
        <% { "day" => "Day", "week" => "Week", "month" => "Month" }.each do |view, label| %>
          <%= link_to label, appointment_calendar_path(view: view),
                class: "join-item btn btn-outline btn-sm #{'btn-active' if @view == view}",
                aria: { current: (@view == view ? "page" : nil) } %>
        <% end %>
      </div>

      <% if @calendars.size > 1 %>
        <%= form_with url: org_appointments_path, method: :get, local: true,
              data: { controller: "auto-submit" }, class: "shrink-0" do %>
          <input type="hidden" name="view" value="<%= @view %>">
          <input type="hidden" name="date" value="<%= @date.iso8601 %>">
          <select name="calendar_id"
                  aria-label="Calendar"
                  class="select-field w-44"
                  data-action="change->auto-submit#submit">
            <option value="">All calendars</option>
            <%= options_from_collection_for_select(@calendars, :id, :name, @calendar&.id) %>
          </select>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <%= form_with url: org_appointments_path, method: :get, local: true,
          class: "flex shrink-0 items-center gap-3" do %>
      <input type="hidden" name="view" value="<%= @view %>">
      <% if @calendar %>
        <input type="hidden" name="calendar_id" value="<%= @calendar.id %>">
      <% end %>

      <%= link_to appointment_calendar_path(date: appointment_calendar_step(@view, @date, -1).iso8601),
            class: "btn btn-ghost btn-sm btn-square", title: "Previous #{@view}" do %>
        <span class="material-symbols-outlined">chevron_left</span>
      <% end %>

      <input type="date"
             name="date"
             value="<%= @date.iso8601 %>"
             lang="en-GB"
             aria-label="Date"
             class="input-field w-36"
             autocomplete="off">

      <button type="submit" class="btn btn-outline btn-sm">Go</button>

      <%= link_to appointment_calendar_path(date: appointment_calendar_step(@view, @date, 1).iso8601),
            class: "btn btn-ghost btn-sm btn-square", title: "Next #{@view}" do %>
        <span class="material-symbols-outlined">chevron_right</span>
      <% end %>

      <%= link_to "Today", appointment_calendar_path(date: Date.current.iso8601), class: "btn btn-ghost btn-sm" %>
    <% end %>

    <% unless @view == "day" %>
      <span class="shrink-0 font-semibold"><%= appointment_calendar_period_label(@view, @period) %></span>
    <% end %>

    <div class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <span class="text-base-content/70"><span class="font-semibold text-base-content"><%= @period_total %></span> total</span>
      <% Appointment::STATUSES.each do |status| %>
        <span class="<%= appointment_status_color(status) %>"><span class="font-semibold"><%= @status_counts[status] %></span> <%= appointment_status_label(status).downcase %></span>
      <% end %>
    </div>
  </div>

  <%= render "org/appointments/#{@view}_view" %>
</section>
