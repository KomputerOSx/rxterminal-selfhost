<tr class="hover:bg-base-200">
  <td class="font-medium whitespace-nowrap"><%= appointment.formatted_time %></td>
  <td>
    <div class="font-medium"><%= appointment_customer_name(appointment) %></div>
  </td>
  <td><%= appointment.service.display_name %></td>
  <td class="font-mono text-xs text-base-content/60"><%= appointment.booking_reference %></td>
  <td><%= appointment_status_badge(appointment) %></td>
  <td>
    <div class="flex justify-end gap-1">
      <%= link_to org_appointment_path(appointment, appointment_calendar_return_params),
            class: "btn btn-ghost btn-xs btn-square",
            title: "View" do %>
        <span class="material-symbols-outlined" style="font-size:18px">visibility</span>
      <% end %>
      <% if appointment_manage_actions?(appointment) && appointment.status == "booked" && appointment.appointment_date == Date.current %>
        <%= button_to check_in_org_appointment_path(appointment), method: :patch,
              class: "btn btn-ghost btn-xs btn-square text-success",
              title: "Check in" do %>
          <span class="material-symbols-outlined" style="font-size:18px">how_to_reg</span>
        <% end %>
      <% end %>
      <% if appointment_manage_actions?(appointment) && appointment.status == "checked_in" %>
        <%= button_to return_to_booked_org_appointment_path(appointment), method: :patch,
              class: "btn btn-ghost btn-xs btn-square text-warning",
              title: "Return to booked",
              data: {
                controller: "confirm-modal",
                action: "click->confirm-modal#confirm",
                confirm_modal_message_value: "Return this appointment to booked?"
              } do %>
          <span class="material-symbols-outlined" style="font-size:18px">undo</span>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
