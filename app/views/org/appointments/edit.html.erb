<section class="w-full max-w-3xl">
  <p class="text-sm font-medium text-base-content/60">
    <%= link_to "Appointments", org_appointments_path, class: "hover:text-base-content" %>
    <span class="mx-1">/</span>
    <span>Edit</span>
  </p>

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold">Edit appointment</h1>
      <p class="mt-1 font-mono text-sm text-base-content/50"><%= @appointment.booking_reference %></p>
    </div>
    <%= link_to "Back", org_appointment_path(@appointment), class: "btn btn-outline btn-sm" %>
  </div>

  <div class="mt-6">
    <%= render "form", appointment: @appointment, services: @services %>
  </div>
</section>
