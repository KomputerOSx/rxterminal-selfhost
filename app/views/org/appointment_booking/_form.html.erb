<%= form_with url: org_appointment_booking_path, method: :patch, class: "mt-6 space-y-6" do %>
  <% if Current.organization.errors.any? %>
    <div class="rounded-lg border border-error/30 bg-error/10 px-4 py-3 text-sm text-error">
      <p class="font-medium">There were some problems with your appointment booking settings:</p>
      <ul class="mt-2 list-inside list-disc">
        <% Current.organization.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card border border-base-300">
    <div class="card-body gap-5">
      <%= form_section_heading "Booking mode", tooltips: true,
            tip: "Rolling dates repeat your weekly bookable windows up to the booking window. Set openings replaces the booking window with openings, each with its own start date, end date and bookable windows." %>

      <div class="flex flex-wrap gap-6">
        <% [ [ "rolling", "Rolling dates" ], [ "openings", "Set openings" ] ].each do |mode, label| %>
          <label class="flex cursor-pointer items-center gap-2">
            <input type="radio"
                   name="organization[appointment_booking_mode]"
                   value="<%= mode %>"
                   class="radio-field"
                   data-action="change->booking-mode#change"
                   <%= "checked" if Current.organization.appointment_booking_mode == mode %>>
            <span class="text-sm font-medium"><%= label %></span>
          </label>
        <% end %>
      </div>
      <%= field_errors(Current.organization, :appointment_booking_mode) %>
    </div>
  </div>

  <div class="space-y-6 <%= "hidden" if Current.organization.booking_mode_openings? %>" data-booking-mode-target="rolling">
  <div class="card border border-base-300">
    <div class="card-body gap-5">
      <div>
        <h2 class="text-lg font-semibold">Booking rules</h2>
      </div>

      <div class="form-control">
        <div class="flex items-center justify-between gap-4">
          <label class="label" for="organization_appointment_days_ahead">
            <span class="label-text">Booking window (days ahead)</span>
          </label>
          <input type="number"
                 id="organization_appointment_days_ahead"
                 name="organization[appointment_days_ahead]"
                 value="<%= Current.organization.appointment_days_ahead %>"
                 min="1"
                 class="<%= error_class_for(Current.organization, :appointment_days_ahead, "input-field w-24") %>">
        </div>
        <%= field_errors(Current.organization, :appointment_days_ahead) %>
      </div>
    </div>
  </div>

  <div class="card border border-base-300">
    <div class="card-body gap-5 p-0">
      <div class="px-8 py-6">
        <h2 class="text-lg font-semibold">Bookable windows</h2>
      </div>

      <%= render "org/appointment_booking/bookable_windows_table", record: Current.organization, field_name: "organization[bookable_times]" %>
    </div>
  </div>

  </div>

  <div class="card border border-base-300">
    <div class="card-body gap-5">
      <h2 class="text-lg font-semibold">Customer emails</h2>

      <label class="flex cursor-pointer items-center gap-3">
        <input type="hidden" name="organization[require_appointment_email]" value="0">
        <input type="checkbox"
               name="organization[require_appointment_email]"
               value="1"
               class="toggle toggle-primary toggle-sm"
               <%= "checked" if Current.organization.require_appointment_email? %>>
        <%= form_option_label "Require an email address for every booking",
              tooltips: true,
              tip: "Applies to online, kiosk and staff bookings. When off, customers can skip the email step." %>
      </label>

      <div class="form-control">
        <label class="label" for="organization_appointment_email_message">
          <%= form_option_label "Message at the bottom of confirmation and reminder emails",
                tooltips: true,
                tip: "Shown below the appointment details. Clear the box to go back to the default message." %>
        </label>
        <textarea id="organization_appointment_email_message"
                  name="organization[appointment_email_message]"
                  rows="4"
                  maxlength="<%= Organization::APPOINTMENT_EMAIL_MESSAGE_MAX_LENGTH %>"
                  class="<%= error_class_for(Current.organization, :appointment_email_message, "textarea-field w-full") %>"><%= Current.organization.appointment_email_message_text %></textarea>
        <%= field_errors(Current.organization, :appointment_email_message) %>
      </div>
    </div>
  </div>

  <div>
    <%= submit_tag "Save appointment booking", class: "btn btn-primary btn-sm" %>
  </div>
<% end %>
