<% organization = local_assigns[:organization] %>
<% services = local_assigns[:services] %>

<div class="portal-theme-preview space-y-4 p-4 pb-6" data-portal-app>
  <%= render layout: "org/portal_appearance/preview_frame", locals: { label: "Home" } do %>
    <div class="min-h-[420px] bg-base-100 text-base-content">
      <header class="portal-chrome border-b border-base-300 px-4 py-3">
        <div class="mx-auto flex max-w-2xl items-center gap-3">
          <% if organization.kiosk_logo.attached? %>
            <%= image_tag organization.kiosk_logo, class: "h-9 w-auto object-contain", alt: "" %>
          <% end %>
          <span class="truncate text-lg font-semibold"><%= organization.name %></span>
        </div>
      </header>
      <main class="mx-auto max-w-2xl px-4 py-8">
        <h1 class="text-2xl font-semibold">Book an appointment</h1>
        <div class="form-control mt-6">
          <label class="label"><span class="label-text">Search services</span></label>
          <input type="search" class="input-field w-full" disabled>
        </div>
        <div class="mt-4 space-y-3">
          <% services.each do |service| %>
            <div class="card border border-base-300">
              <div class="card-body flex-row items-center gap-4 p-5">
                <% if service.icon.present? %>
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <%= material_icon(service.icon, size: 22) %>
                  </div>
                <% end %>
                <div class="min-w-0 flex-1">
                  <p class="font-medium"><%= service.display_name %></p>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-base-content/60">
                    <span class="inline-flex items-center gap-1">
                      <%= material_icon("schedule", size: 14) %>
                      <%= service.estimated_duration %> min
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <%= material_icon("sell", size: 14) %>
                      <%= portal_service_price_label(service) %>
                    </span>
                  </div>
                </div>
                <%= material_icon("chevron_right", size: 20, class: "shrink-0 text-base-content/40") %>
              </div>
            </div>
          <% end %>
        </div>
      </main>
    </div>
  <% end %>

  <%= render layout: "org/portal_appearance/preview_frame", locals: { label: "Arrive" } do %>
    <div class="min-h-[360px] bg-base-100 text-base-content">
      <main class="mx-auto max-w-2xl px-4 py-8">
        <h1 class="text-2xl font-semibold">Welcome to <%= organization.name %></h1>
        <div class="mt-6 space-y-3">
          <div class="card border border-primary">
            <div class="card-body flex-row items-center gap-4 p-5">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <%= material_icon("groups", size: 26) %>
              </div>
              <p class="flex-1 text-lg font-medium">Join the queue</p>
              <%= material_icon("chevron_right", size: 20, class: "text-base-content/40") %>
            </div>
          </div>
          <div class="card border border-base-300">
            <div class="card-body flex-row items-center gap-4 p-5">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <%= material_icon("calendar_month", size: 26) %>
              </div>
              <p class="flex-1 text-lg font-medium">Book appointment</p>
              <%= material_icon("chevron_right", size: 20, class: "text-base-content/40") %>
            </div>
          </div>
        </div>
      </main>
    </div>
  <% end %>

  <%= render layout: "org/portal_appearance/preview_frame", locals: { label: "Form" } do %>
    <div class="min-h-[360px] bg-base-100 text-base-content">
      <main class="mx-auto max-w-2xl px-4 py-8">
        <h1 class="text-2xl font-semibold">Join the queue</h1>
        <div class="card mt-6 border border-base-300">
          <div class="card-body gap-5">
            <div class="grid grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label"><span class="label-text">First name *</span></label>
                <input type="text" class="input-field w-full" value="Jane" readonly>
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text">Last name *</span></label>
                <input type="text" class="input-field w-full" value="Doe" readonly>
              </div>
            </div>
            <div class="form-control">
              <label class="label"><span class="label-text">Date of birth *</span></label>
              <input type="text" class="input-field w-full" value="01-01-1990" readonly>
            </div>
          </div>
        </div>
        <button type="button" class="btn btn-primary btn-sm mt-5 w-full">Join the queue</button>
      </main>
    </div>
  <% end %>
</div>
