<%= turbo_frame_tag dom_id(request, :completed) do %>
  <div class="card border border-base-300"
       data-request-id="<%= request.id %>"
       data-service-id="<%= request.service_id %>">
    <div class="card-body gap-3 p-3">
      <div class="flex items-stretch justify-between gap-3">
        <div class="flex min-w-0 items-start gap-3">
          <div class="flex w-14 shrink-0 flex-col items-center text-center">
            <div class="text-4xl font-black leading-none text-success lg:text-5xl"><%= request.queue_number %></div>
            <div class="mt-1 text-[10px] text-base-content/50">
              <span class="material-symbols-outlined !text-[12px] text-success">check_circle</span>
              <%= request.completed_at&.strftime("%H:%M") %>
            </div>
          </div>
          <div class="min-w-0">
            <div class="font-semibold"><%= request.last_name %>, <%= request.first_name %></div>
            <div class="text-xs text-base-content/60">
              <% if request.dob.present? %>
              DOB: <span class="text-base-content"><%= request.dob&.strftime("%d/%m/%Y") %></span> <% if request.postcode.present? %>|<% end %>
              <% end %>

              <% if request.postcode.present? %>
                %<span class="text-base-content"><%= request.postcode.upcase %></span>
              <% end %>
            </div>
            <div class="mt-1 text-xs text-base-content/70"><%= request.service.display_name %></div>
          </div>
        </div>

        <div class="flex shrink-0 items-center">
          <%= button_to org_revert_completed_queue_path(request),
                method: :patch,
                class: "btn btn-warning btn-outline btn-xs",
                form: { data: { turbo_stream: true } } do %>
            Revert
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
