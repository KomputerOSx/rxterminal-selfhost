<div class="overflow-x-auto">
  <div class="min-w-[640px]">
    <div class="grid grid-cols-[2.5rem_repeat(24,minmax(0,1fr))] gap-0.5">
      <div></div>
      <% 24.times do |hour| %>
        <div class="pb-1 text-center text-[10px] font-medium text-base-content/40">
          <%= hour.even? ? hour : "" %>
        </div>
      <% end %>

      <% AnalyticsHelper::HEATMAP_DAY_LABELS.each_with_index do |day_label, day_index| %>
        <div class="flex items-center pr-2 text-xs font-medium text-base-content/50"><%= day_label %></div>
        <% 24.times do |hour| %>
          <% count = heatmap[day_index][hour] %>
          <div class="<%= heatmap_cell_class(count, heatmap_max) %> aspect-square rounded-sm border border-base-300/50"
               title="<%= day_label %> <%= hour.to_s.rjust(2, "0") %>:00 — <%= count %> <%= "request".pluralize(count) %>">
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="mt-3 flex items-center justify-end gap-2 text-xs text-base-content/50">
      <span>Less</span>
      <div class="flex gap-0.5">
        <div class="h-3 w-3 rounded-sm border border-base-300/50 bg-base-200/30"></div>
        <div class="h-3 w-3 rounded-sm border border-base-300/50 bg-primary/20"></div>
        <div class="h-3 w-3 rounded-sm border border-base-300/50 bg-primary/40"></div>
        <div class="h-3 w-3 rounded-sm border border-base-300/50 bg-primary/60"></div>
        <div class="h-3 w-3 rounded-sm border border-base-300/50 bg-primary/80"></div>
      </div>
      <span>More</span>
    </div>
  </div>
</div>
