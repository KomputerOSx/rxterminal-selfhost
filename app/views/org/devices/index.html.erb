<section class="w-full max-w-5xl">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold">Devices</h1>

    <div class="flex flex-wrap gap-2">
      <%= link_to new_org_device_path, class: "btn btn-primary btn-sm gap-1" do %>
        <span class="material-symbols-outlined !text-[18px]">add</span>
        New device
      <% end %>
    </div>
  </div>

  <%= form_with url: org_devices_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do %>
    <div class="form-control min-w-[12rem] flex-1">
      <label class="label py-0"><span class="label-text text-xs">Search</span></label>
      <%= text_field_tag :search, params[:search],
            class: "input-field w-full",
            autocomplete: "off" %>
    </div>
    <div class="form-control w-40">
      <label class="label py-0"><span class="label-text text-xs">Status</span></label>
      <%= select_tag :status,
            options_for_select([
              [ "Active & inactive", "" ],
              [ "Active", "active" ],
              [ "Inactive", "inactive" ],
              [ "Revoked", "revoked" ]
            ], params[:status]),
            class: "select-field w-full" %>
    </div>
    <button type="submit" class="btn btn-outline btn-sm">Filter</button>
    <% if params[:search].present? || params[:status].present? %>
      <%= link_to "Clear", org_devices_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>

  <% if @devices.any? %>
    <p class="mt-4 text-sm text-base-content/60"><%= @devices.total_count %> device<%= @devices.total_count == 1 ? "" : "s" %></p>

    <div class="card mt-4 border border-base-300">
      <div class="card-body p-0">
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead class="bg-base-200 text-sm font-semibold text-base-content">
              <tr class="border-b border-base-300">
                <th>Device ID</th>
                <th>Name</th>
                <th>Status</th>
                <th>Registered IP</th>
                <th>Last seen</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "org/devices/device_row", collection: @devices, as: :device %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <% if @devices.total_pages > 1 %>
      <nav class="mt-4 flex justify-center" aria-label="Pagination">
        <%= paginate @devices %>
      </nav>
    <% end %>
  <% else %>
    <p class="mt-6 text-sm text-base-content/60">
      <% if params[:search].present? || params[:status].present? %>
        No devices found.
      <% else %>
        No devices yet.
      <% end %>
    </p>
  <% end %>
</section>
