<section class="w-full max-w-5xl">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold">Services</h1>

    <div class="flex flex-wrap gap-2">
      <%= link_to new_org_service_path, class: "btn btn-primary btn-sm gap-1" do %>
        <span class="material-symbols-outlined !text-[18px]">add</span>
        New service
      <% end %>
    </div>
  </div>

  <% if @services.any? %>
    <div class="card mt-6 border border-base-300">
      <div class="card-body p-0">
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead class="bg-base-200 text-sm font-semibold text-base-content">
              <tr class="border-b border-base-300">
                <th>Service</th>
                <th>Duration</th>
                <th>Price</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="services_table_body">
              <%= render partial: "org/services/service_row", collection: @services, as: :service %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <p class="mt-6 text-sm text-base-content/60">No services yet.</p>
  <% end %>
</section>
