<h1 style="margin:0 0 8px;font-size:28px;font-weight:400;color:<%= MailerTheme::HEADING_TEXT %>;line-height:1.2;">
  You're invited
</h1>

<p style="margin:0 0 24px;font-size:15px;color:<%= MailerTheme::BODY_TEXT %>;">
  <%= @invitation.invited_by&.email || "Someone" %> invited you to join
  <strong style="color:<%= MailerTheme::HEADING_TEXT %>;"><%= @invitation.organization.name %></strong>.
</p>

<div style="background:<%= MailerTheme::CARD_BG %>;border-radius:12px;padding:28px 24px;margin-bottom:24px;">
  <a href="<%= invitation_url(@raw_token) %>"
     style="display:inline-block;background:<%= MailerTheme::PRIMARY %>;color:<%= MailerTheme::PRIMARY_CONTENT %>;text-decoration:none;font-size:15px;font-weight:700;padding:12px 18px;border-radius:8px;">
    Accept invitation
  </a>
  <p style="margin:16px 0 0;font-size:14px;color:<%= MailerTheme::MUTED_TEXT %>;">
    This invitation will expire in <%= @expires_in_days %> days.
  </p>
  <%= render "shared/mailer/link_fallback", url: invitation_url(@raw_token) %>
</div>

<p style="margin:0;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;">
  If you weren't expecting this, you can safely ignore this email.
</p>
