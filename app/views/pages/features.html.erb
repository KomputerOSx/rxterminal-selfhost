        <ul class="feat-check-list">
          <li><%= material_icon("check_circle", size: 20) %> Works in any phone browser</li>
          <li><%= material_icon("check_circle", size: 20) %> Live position and wait estimate</li>
          <li><%= material_icon("check_circle", size: 20) %> Appeal to younger customers</li>

        </ul>
