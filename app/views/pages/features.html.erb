          <li><%= material_icon("check_circle", size: 20) %> Call, complete, or return in one click</li>
          <li><%= material_icon("check_circle", size: 20) %> Voice announcements and a waiting-room display</li>
          <li><%= material_icon("check_circle", size: 20) %> Live wait times and daily totals</li>
        </ul>
      </div>
    </div>

