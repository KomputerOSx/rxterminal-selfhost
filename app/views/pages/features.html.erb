<% content_for :title, "Features" %>
<% content_for :meta_description, "Every way your customers arrive, one queue. Kiosk self check-in, mobile QR check-in, online booking, and a live staff queue - all in RxTerminal." %>

<main class="wire">

  <section class="sec feat-hero">
    <h1 class="h-display h-display--lg-w"><span class="text-primary">One Platform</span><br>For All Your Needs</h1>
    <p class="lead lead--mt">Kiosk, phone, or online booking. RxTerminal keeps the counter moving and the waiting room calm.</p>
    <div class="hero__actions">
      <%= link_to "Start your free trial", new_registration_path, class: "btn btn-primary" %>
      <%= link_to "Talk to us", contact_path, class: "btn btn-outline" %>
    </div>
  </section>

  <section class="sec">

