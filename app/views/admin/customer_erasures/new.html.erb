<section class="w-full max-w-5xl">
  <p class="text-sm font-medium text-base-content/60">Admin</p>
  <h1 class="mt-3 text-4xl font-semibold tracking-normal">Customer erasure</h1>

  <%= form_with model: @search, url: admin_customer_erasures_path, method: :post, scope: :customer_pii_search, data: { turbo: false } do |f| %>
    <% unless @erasure_complete %>
      <div class="mt-8">
        <%= form_section_heading "Search",
              tooltips: true,
              tip: "Find appointments and queue records by first name and last name. Add a date of birth and postcode to narrow results further." %>

        <div class="mt-4">
          <%= render "admin/customer_pii/search_form_fields", f: f, search: @search %>
        </div>
      </div>

      <div class="mt-10">
        <%= form_section_heading "Organizations",
              tooltips: true,
              tip: "Limit the search to one or more workspaces. Required when no date of birth is given - organization names are not unique, so use slug, ID, address, contact details, owner email, and custom domain to pick the right ones. Optional (searches all organizations) when a date of birth is provided." %>

        <%= render "admin/customer_pii/organization_selection",
              organizations: @organizations,
              selected_ids: @search.organization_ids %>
      </div>

      <%= f.submit "Search", class: "btn btn-primary btn-sm mt-4" %>
    <% end %>

    <% if defined?(@results) && @results %>
      <%= render "admin/customer_pii/results",
            results: @results,
            show_selection: true,
            searched: true %>

      <%= render "admin/customer_pii/report_delivery",
            export_token: nil,
            recipient_email: params[:recipient_email],
            results: @results %>

      <% if @results.appointments.any? || @results.service_requests.any? %>
        <div class="mt-10">
          <h2 class="text-lg font-semibold">Confirm erasure</h2>

          <div class="card mt-4 border border-base-300">
            <div class="card-body">
              <label class="label cursor-pointer justify-start gap-2">
                <input type="checkbox" name="confirm" value="1" class="checkbox-field" required>
                <span class="label-text">I understand this permanently redacts customer PII on the selected records</span>
              </label>

              <%= hidden_field_tag :confirm_erasure, "1" %>
              <%= f.submit "Redact selected records",
                    class: "btn btn-error btn-sm mt-4",
                    data: {
                      controller: "confirm-modal",
                      action: "click->confirm-modal#confirm",
                      confirm_modal_message_value: "Permanently redact PII on the selected records? This cannot be undone."
                    } %>
            </div>
          </div>
        </div>
      <% end %>
    <% elsif @erasure_complete %>
      <%= render "admin/customer_pii/report_delivery",
            export_token: @export_token,
            recipient_email: params[:recipient_email],
            results: nil %>

      <div class="mt-4">
        <%= link_to "New search", new_admin_customer_erasure_path, class: "btn btn-outline btn-sm" %>
      </div>
    <% end %>
  <% end %>
</section>
