<div class="modal-box">
  <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="click->modal#close">✕</button></form>

  <h3 class="font-bold text-lg mb-4">Decline logo</h3>

  <%= form_with model: organization_logo, url: decline_admin_organization_logo_path(organization_logo), method: :patch,
        html: { class: "space-y-4", data: { action: "turbo:submit-end->modal#closeOnSuccess" } } do |f| %>
    <div class="form-control">
      <%= f.label :decline_reason, class: "label" do %>
        <span class="label-text">Reason</span>
      <% end %>
      <%= f.text_area :decline_reason, rows: 4, class: error_class_for(organization_logo, :decline_reason, "textarea-field w-full") %>
      <%= field_errors(organization_logo, :decline_reason) %>
    </div>

    <div class="form-control mt-2">
      <%= f.submit "Decline", class: "btn btn-error w-full" %>
    </div>
  <% end %>
</div>
<form method="dialog" class="modal-backdrop"><button>close</button></form>
