<section class="w-full max-w-7xl">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-sm font-medium text-base-content/60">
        <%= link_to "Webhook Events", @webhook_events_back_path, class: "hover:text-base-content" %>
        <span class="mx-1">/</span>
        <span>#<%= @webhook_event.id %></span>
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-normal">Webhook Event</h1>
      <p class="mt-1 font-mono text-sm text-base-content/60"><%= @webhook_event.event_type %></p>
    </div>
    <%= link_to @webhook_events_back_path, class: "btn btn-outline btn-sm shrink-0 gap-1" do %>
      <span class="material-symbols-outlined !text-[18px]">arrow_back</span>
      Back
    <% end %>
  </div>

  <div class="mt-8 card border border-base-300">
    <div class="card-body">
      <h2 class="text-lg font-semibold">Event Details</h2>

      <dl class="mt-2 divide-y divide-base-300">
        <div class="flex items-center justify-between py-3">
          <dt class="text-xs uppercase tracking-wide text-base-content/60">Record ID</dt>
          <dd class="font-medium">#<%= @webhook_event.id %></dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="text-xs uppercase tracking-wide text-base-content/60">Processor</dt>
          <dd class="font-medium"><%= @webhook_event.processor %></dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="text-xs uppercase tracking-wide text-base-content/60">Event type</dt>
          <dd class="font-mono text-sm"><%= @webhook_event.event_type %></dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="text-xs uppercase tracking-wide text-base-content/60">Received</dt>
          <dd class="font-medium"><%= @webhook_event.created_at.strftime("%B %d, %Y at %H:%M:%S %Z") %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="mt-8 card border border-base-300">
    <div class="card-body">
      <h2 class="text-lg font-semibold">Raw event JSON</h2>
      <% event_payload = @webhook_event.event.is_a?(Hash) ? @webhook_event.event : @webhook_event.event.as_json %>
      <pre class="mt-4 rounded-box bg-base-200 p-4 text-xs whitespace-pre-wrap break-all"><%= JSON.pretty_generate(event_payload) %></pre>
    </div>
  </div>
</section>
