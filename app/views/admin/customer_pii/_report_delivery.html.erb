<% if export_token.present? || (defined?(results) && results && (results.appointments.any? || results.service_requests.any?)) %>
  <div class="mt-10">
    <h2 class="text-lg font-semibold">Report</h2>

    <div class="card mt-4 border border-base-300">
      <div class="card-body">
        <div class="form-control max-w-md">
          <label class="label"><span class="label-text">Recipient email</span></label>
          <input type="email"
                 name="recipient_email"
                 value="<%= recipient_email %>"
                 class="input-field w-full"
                 autocomplete="off">
        </div>

        <% if export_token.present? %>
          <%= hidden_field_tag :export_token, export_token %>
        <% end %>

        <div class="mt-4 flex flex-wrap gap-2">
          <% if export_token.present? %>
            <%= link_to "Download CSV",
                  admin_customer_pii_export_path(export_token),
                  class: "btn btn-outline btn-sm" %>
            <%= button_tag "Email report", name: "email_export", value: "1", class: "btn btn-outline btn-sm" %>
          <% else %>
            <%= button_tag "Download CSV", name: "export", value: "1", class: "btn btn-outline btn-sm" %>
            <%= button_tag "Email report", name: "email_export", value: "1", class: "btn btn-outline btn-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
