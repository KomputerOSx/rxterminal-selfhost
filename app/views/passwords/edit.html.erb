<% content_for :title, "Password" %>
<section class="mx-auto w-full max-w-md">
  <div class="card bg-base-200 shadow-sm">
    <div class="card-body">
      <h1 class="card-title text-2xl font-bold"><%= current_user.has_password? ? "Change your password" : "Set a password" %></h1>
      <% unless current_user.has_password? %>
        <p class="text-sm text-base-content/60">
          You signed up with a third-party authenticating service and don't have a password yet. Set one to log in directly or enable an authenticator app.
        </p>
      <% end %>

      <%= form_with url: password_path,
                    method: :patch,
                    html: {
                      class: "mt-4 space-y-4",
                      data: {
                        controller: "password-requirements",
                        password_requirements_min_length_value: User::MIN_PASSWORD_LENGTH
                      }
                    } do %>
        <% if current_user.has_password? %>
          <div class="form-control">
            <label class="label" for="current_password"><span class="label-text">Current password</span></label>
            <input type="password" name="current_password" id="current_password" autocomplete="current-password" class="input-field w-full">
          </div>

          <div class="divider"></div>
        <% end %>

        <div class="form-control">
          <label class="label" for="password"><span class="label-text">New password</span></label>
          <input type="password" name="password" id="password" autocomplete="new-password" class="input-field w-full"
                 data-password-requirements-target="password"
                 data-action="input->password-requirements#check">
        </div>

        <div class="form-control">
          <label class="label" for="password_confirmation"><span class="label-text">Confirm new password</span></label>
          <input type="password" name="password_confirmation" id="password_confirmation" autocomplete="new-password" class="input-field w-full"
                 data-password-requirements-target="confirmation"
                 data-action="input->password-requirements#check">
          <%= render "registrations/password_requirements" %>
        </div>

        <div class="form-control mt-2">
          <%= submit_tag current_user.has_password? ? "Change my password" : "Set my password", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
