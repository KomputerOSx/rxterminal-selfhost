<% service          = local_assigns[:service] %>
<% collect_dob       = local_assigns.fetch(:collect_dob, true) %>
<% collect_postcode = local_assigns.fetch(:collect_postcode, true) %>
<% postcode_region  = local_assigns.fetch(:postcode_region, "uk") %>
<% postcode_label   = { "uk" => "Postcode", "us" => "ZIP Code", "ca" => "Postal Code", "au" => "Postcode" }.fetch(postcode_region, "Postcode") %>

<div class="flex min-h-full flex-col items-center justify-center gap-6 p-5">

  <div class="flex w-full max-w-3xl items-center gap-4">
    <button data-action="pointerdown->kiosk-appointment#confirmBack"
            class="btn btn-outline h-[54px] min-h-0 w-[70px] shrink-0 rounded-xl p-0">
      <span class="material-symbols-outlined">arrow_back</span>
    </button>
    <div class="flex-1 text-center">
      <div class="mb-1 text-5xl font-bold tracking-tight text-base-content md:text-6xl">Confirm Booking</div>
      <div class="text-xl text-base-content/70">
        <span class="keep-english"><%= service&.display_name %></span> &middot; Step 7 of 7
      </div>
    </div>
    <% if @upsell_booking_mode %>
      <%= render "kiosk/appointments/upsell_booking_cancel_button", compact: true %>
    <% else %>
      <div class="h-[54px] w-[70px] shrink-0" aria-hidden="true"></div>
    <% end %>
  </div>

  <div class="flex w-full max-w-3xl flex-col gap-6">

    <div data-kiosk-appointment-target="confirmError"
         class="alert alert-error hidden text-base font-semibold"></div>

    <div class="card overflow-hidden rounded-[20px] border border-base-300 bg-base-200">

      <div class="flex items-center gap-4 border-b border-base-300 bg-primary/10 px-6 py-4">
        <% if service&.icon.present? %>
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-base-100">
            <span class="material-symbols-outlined text-primary"><%= service.icon %></span>
          </div>
        <% end %>
        <div class="text-3xl font-bold text-primary"><span class="keep-english"><%= service&.display_name %></span></div>
      </div>

      <div class="grid grid-cols-2 border-b border-base-300">
        <div class="border-r border-base-300 px-6 py-4">
          <div class="text-sm font-medium text-base-content/70">Date</div>
          <div data-kiosk-appointment-target="confirmDate" class="text-xl font-bold text-base-content"></div>
        </div>
        <div class="px-6 py-4">
          <div class="text-sm font-medium text-base-content/70">Time</div>
          <div data-kiosk-appointment-target="confirmTime" class="text-2xl font-bold text-base-content"></div>
        </div>
      </div>

      <% confirm_rows = [
        { label: "First Name",    target: "confirmFirstName" },
        { label: "Last Name",     target: "confirmLastName"  },
      ]
      confirm_rows << { label: "Date of Birth", target: "confirmDob" } if collect_dob
      confirm_rows << { label: postcode_label, target: "confirmPostcode" } if collect_postcode
      confirm_rows += [
        { label: "Email", target: "confirmEmail" },
        { label: "Note",  target: "confirmNotes" },
      ]
      confirm_rows.each do |row| %>
        <div class="flex items-center border-b border-base-300 px-6 py-4 last:border-b-0">
          <span class="w-36 shrink-0 text-lg font-medium text-base-content/70"><%= row[:label] %></span>
          <span data-kiosk-appointment-target="<%= row[:target] %>"
                class="text-3xl font-bold text-base-content"></span>
        </div>
      <% end %>

    </div>

    <button data-kiosk-appointment-target="submitBtn"
            data-action="pointerdown->kiosk-appointment#confirmSubmit"
            class="btn btn-primary h-[76px] min-h-0 w-full gap-3 rounded-2xl border-0 text-xl font-bold">
      Confirm Booking
    </button>
  </div>
</div>
