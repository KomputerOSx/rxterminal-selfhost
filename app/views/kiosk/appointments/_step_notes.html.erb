<div class="flex min-h-full flex-col items-center justify-center gap-6 p-5">

  <div class="flex w-full max-w-3xl items-center gap-4">
    <button data-action="pointerdown->kiosk-appointment#notesBack"
            class="btn btn-outline h-[54px] min-h-0 w-[70px] shrink-0 rounded-xl p-0">
      <span class="material-symbols-outlined">arrow_back</span>
    </button>
    <div class="flex-1 text-center">
      <div class="mb-1 text-5xl font-bold tracking-tight text-base-content md:text-6xl">Leave a Note</div>
      <div class="text-xl text-base-content/70">Optional &middot; Step 6 of 7</div>
    </div>
    <% if @upsell_booking_mode %>
      <%= render "kiosk/appointments/upsell_booking_cancel_button" %>
    <% else %>
      <button data-action="pointerdown->kiosk-appointment#notesReset"
              class="btn btn-outline h-[54px] min-h-0 w-[70px] shrink-0 rounded-xl p-0 text-xs font-bold uppercase tracking-widest">
        Clear
      </button>
    <% end %>
  </div>

  <div class="card w-full max-w-3xl border border-base-300 bg-base-200">
    <div class="card-body p-9">

      <div class="kiosk-input-surface mb-5 rounded-2xl border-2 p-5">
        <div class="mb-1 text-xs font-bold uppercase tracking-widest text-base-content/60">Note</div>
        <div data-kiosk-appointment-target="notesDisplay" class="min-h-[48px] text-2xl font-bold text-base-content/40">&middot;</div>
        <div class="mt-2 flex items-center justify-between gap-3">
          <div class="text-xs text-base-content/50">e.g. Allergies, Reasonable Adjustments, Access Requirements</div>
          <div data-kiosk-appointment-target="notesCharCount" class="shrink-0 text-xs font-semibold text-base-content/50">200 characters remaining</div>
        </div>
      </div>

      <div class="mb-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-base-content/60">Quick picks</div>
        <div class="flex flex-wrap gap-2">
          <% [
            { label: "Wheelchair Access", icon: "accessible" },
            { label: "Hearing Loop Required", icon: "hearing" },
            { label: "Carer Accompanying", icon: "group" },
          ].each do |chip| %>
            <button data-action="pointerdown->kiosk-appointment#notesChipPress"
                    data-note="<%= chip[:label] %>"
                    class="btn btn-outline btn-sm gap-1.5">
              <span class="material-symbols-outlined text-base"><%= chip[:icon] %></span>
              <%= chip[:label] %>
            </button>
          <% end %>
        </div>
      </div>

      <div class="flex flex-col items-center gap-2">
        <div class="grid grid-cols-10 gap-2">
          <% %w[Q W E R T Y U I O P].each do |k| %>
            <button data-action="pointerdown->kiosk-appointment#notesKey" data-key="<%= k %>"
                    class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
          <% end %>
        </div>
        <div class="grid grid-cols-9 gap-2 pl-6">
          <% %w[A S D F G H J K L].each do |k| %>
            <button data-action="pointerdown->kiosk-appointment#notesKey" data-key="<%= k %>"
                    class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
          <% end %>
        </div>
        <div class="grid grid-cols-8 gap-2 pl-12">
          <% %w[Z X C V B N M].each do |k| %>
            <button data-action="pointerdown->kiosk-appointment#notesKey" data-key="<%= k %>"
                    class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
          <% end %>
          <button data-action="pointerdown->kiosk-appointment#notesKey" data-key="⌫"
                  class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--delete h-14 w-14 min-h-0 px-0">
            <span class="material-symbols-outlined">backspace</span>
          </button>
        </div>
        <div class="flex gap-2">
          <button data-action="pointerdown->kiosk-appointment#notesKey" data-key="SPACE"
                  class="btn btn-lg kiosk-keyboard-key h-14 min-h-0 w-64 text-sm font-bold uppercase tracking-widest">Space</button>
          <button data-action="pointerdown->kiosk-appointment#notesKey" data-key="."
                  class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--accent h-14 min-h-0 w-14 text-lg font-bold">.</button>
          <button data-action="pointerdown->kiosk-appointment#notesKey" data-key=","
                  class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--accent h-14 min-h-0 w-14 text-lg font-bold">,</button>
        </div>
      </div>

      <div class="mt-4 flex justify-center gap-3">
        <button data-action="pointerdown->kiosk-appointment#notesSkip"
                class="btn btn-outline h-[62px] min-h-0 w-32 rounded-2xl text-sm font-bold uppercase tracking-widest">
          Skip
        </button>
        <button data-action="pointerdown->kiosk-appointment#notesKey" data-key="→"
                class="btn btn-primary h-[62px] min-h-0 w-[220px] gap-2 rounded-2xl border-0 text-sm font-bold uppercase tracking-widest">
          <span class="material-symbols-outlined">check</span>
          Confirm &amp; Review
        </button>
      </div>

    </div>
  </div>
</div>
