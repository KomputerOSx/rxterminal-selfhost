<div class="flex min-h-full flex-col items-center justify-center gap-6 overflow-y-auto p-4">

  <div class="flex w-full max-w-3xl items-center gap-4">
    <button data-action="pointerdown->kiosk-appointment#emailBack"
            class="btn btn-outline h-[54px] min-h-0 w-[70px] shrink-0 rounded-xl p-0">
      <span class="material-symbols-outlined">arrow_back</span>
    </button>
    <div class="flex-1 text-center">
      <div class="mb-1 text-5xl font-bold tracking-tight text-base-content md:text-6xl">Email Address</div>
      <div class="text-xl text-base-content/70"><%= @organization.require_appointment_email? ? "Required" : "Optional" %> &middot; Step 5 of 7</div>
    </div>
    <% if @upsell_booking_mode %>
      <%= render "kiosk/appointments/upsell_booking_cancel_button" %>
    <% else %>
      <button data-action="pointerdown->kiosk-appointment#emailReset"
              class="btn btn-outline h-[54px] min-h-0 w-[70px] shrink-0 rounded-xl p-0 text-xs font-bold uppercase tracking-widest">
        Clear
      </button>
    <% end %>
  </div>

  <div class="card w-full max-w-3xl border border-base-300 bg-base-200">
    <div class="card-body p-9">

      <div data-kiosk-appointment-target="emailSkippedView" class="hidden flex-col items-center gap-4 py-8">
        <span class="material-symbols-outlined text-5xl text-base-content/40">mail</span>
        <div class="text-base font-medium text-base-content/70">Email skipped</div>
        <button data-action="pointerdown->kiosk-appointment#emailUnskip"
                class="btn btn-outline btn-sm">Enter email instead</button>
      </div>

      <div data-kiosk-appointment-target="emailKeyboardView">
        <div data-kiosk-appointment-target="emailField"
             data-state="idle"
             class="email-field mb-5 rounded-2xl border-2 p-5">
          <div data-kiosk-appointment-target="emailLabel" class="mb-1 text-xs font-bold uppercase tracking-widest text-base-content/60">Email</div>
          <div data-kiosk-appointment-target="emailDisplay" class="truncate text-2xl font-bold text-base-content/40">name@example.com</div>
          <div data-kiosk-appointment-target="emailErrorMsg" class="mt-1 hidden text-sm font-semibold text-error"></div>
        </div>

        <div class="mb-4">
          <div class="mb-2 text-xs font-bold uppercase tracking-widest text-base-content/60">Quick domains</div>
          <div class="flex flex-wrap gap-2">
            <% %w[@gmail.com @hotmail.com @outlook.com @yahoo.com @icloud.com @nhs.net @live.co.uk @btinternet.com].each do |domain| %>
              <button data-kiosk-appointment-target="emailChip"
                      data-action="pointerdown->kiosk-appointment#emailChipPress"
                      data-domain="<%= domain %>"
                      data-active="false"
                      class="btn btn-lg btn-outline h-12 min-h-0 px-4 text-base font-semibold data-[active=true]:btn-primary"><%= domain %></button>
            <% end %>
          </div>
        </div>

        <div class="flex flex-col items-center gap-2">
          <div class="grid grid-cols-10 gap-2">
            <% %w[1 2 3 4 5 6 7 8 9 0].each do |k| %>
              <button data-action="pointerdown->kiosk-appointment#emailKey" data-key="<%= k %>"
                      class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
            <% end %>
          </div>
          <div class="my-0.5 h-px w-full max-w-[692px] bg-base-300"></div>
          <div class="grid grid-cols-10 gap-2">
            <% %w[Q W E R T Y U I O P].each do |k| %>
              <button data-action="pointerdown->kiosk-appointment#emailKey" data-key="<%= k %>"
                      class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
            <% end %>
          </div>
          <div class="grid grid-cols-9 gap-2 pl-6">
            <% %w[A S D F G H J K L].each do |k| %>
              <button data-action="pointerdown->kiosk-appointment#emailKey" data-key="<%= k %>"
                      class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
            <% end %>
          </div>
          <div class="grid grid-cols-8 gap-2 pl-12">
            <% %w[Z X C V B N M].each do |k| %>
              <button data-action="pointerdown->kiosk-appointment#emailKey" data-key="<%= k %>"
                      class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
            <% end %>
            <button data-action="pointerdown->kiosk-appointment#emailKey" data-key="⌫"
                    class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--delete h-14 w-14 min-h-0 px-0">
              <span class="material-symbols-outlined">backspace</span>
            </button>
          </div>
          <div class="flex gap-2">
            <% %w[- _ @ .].each do |k| %>
              <button data-action="pointerdown->kiosk-appointment#emailKey" data-key="<%= k %>"
                      class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--accent h-14 min-h-0 w-14 text-lg font-bold"><%= k %></button>
            <% end %>
          </div>
        </div>

        <div class="mt-4 flex justify-center gap-3">
          <% unless @organization.require_appointment_email? %>
            <button data-action="pointerdown->kiosk-appointment#emailSkip"
                    class="btn btn-outline h-[62px] min-h-0 w-32 rounded-2xl text-sm font-bold uppercase tracking-widest">
              Skip
            </button>
          <% end %>
          <button data-kiosk-appointment-target="emailConfirmBtn"
                  data-action="pointerdown->kiosk-appointment#emailConfirm"
                  class="btn btn-disabled h-[62px] min-h-0 w-[172px] gap-2 rounded-2xl text-sm font-bold uppercase tracking-widest">
            <span class="material-symbols-outlined">check</span>
            Confirm
          </button>
        </div>
      </div>

    </div>
  </div>
</div>
