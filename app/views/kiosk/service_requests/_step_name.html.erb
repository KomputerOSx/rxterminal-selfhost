<%# Step 1: Name - touch keyboard %>
<% service = local_assigns[:service] %>

<div class="flex min-h-full flex-col items-center justify-center gap-6 p-5">

  <div class="flex w-full max-w-3xl items-center gap-4">
    <button data-action="pointerdown->kiosk-service-request#nameBack"
            class="btn btn-outline h-[54px] min-h-0 w-[70px] shrink-0 rounded-xl p-0">
      <span class="material-symbols-outlined">arrow_back</span>
    </button>
    <div class="flex-1 text-center">
      <div class="mb-1 text-5xl font-bold tracking-tight text-base-content md:text-6xl">Customer Name</div>
      <div class="text-xl text-base-content/70"><span class="keep-english"><%= service&.display_name %></span> &middot; Step 1 of 4</div>
    </div>
    <button data-action="pointerdown->kiosk-service-request#nameReset"
            class="btn btn-outline h-[54px] min-h-0 w-[70px] shrink-0 rounded-xl p-0 text-xs font-bold uppercase tracking-widest">
      Clear
    </button>
  </div>

  <div class="card w-full max-w-3xl border border-base-300 bg-base-200">
    <div class="card-body p-9">

      <div class="mb-5 flex gap-3">
        <div data-kiosk-service-request-target="firstWrap"
             data-action="pointerdown->kiosk-service-request#nameFocus"
             data-field="first" data-active="true"
             class="kiosk-input-field flex-1 cursor-pointer">
          <div class="mb-1 text-xs font-bold uppercase tracking-widest text-base-content/60">First Name</div>
          <div data-kiosk-service-request-target="firstDisplay" class="text-3xl font-bold text-base-content">&middot;</div>
        </div>
        <div data-kiosk-service-request-target="lastWrap"
             data-action="pointerdown->kiosk-service-request#nameFocus"
             data-field="last" data-active="false"
             class="kiosk-input-field flex-1 cursor-pointer">
          <div class="mb-1 text-xs font-bold uppercase tracking-widest text-base-content/60">Last Name</div>
          <div data-kiosk-service-request-target="lastDisplay" class="text-3xl font-bold text-base-content">&middot;</div>
        </div>
      </div>

      <div class="flex flex-col items-center gap-2">
        <div class="grid grid-cols-10 gap-2">
          <% %w[Q W E R T Y U I O P].each do |k| %>
            <button data-action="pointerdown->kiosk-service-request#nameKey" data-key="<%= k %>"
                    class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
          <% end %>
        </div>
        <div class="grid grid-cols-9 gap-2 pl-6">
          <% %w[A S D F G H J K L].each do |k| %>
            <button data-action="pointerdown->kiosk-service-request#nameKey" data-key="<%= k %>"
                    class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
          <% end %>
        </div>
        <div class="grid grid-cols-8 gap-2 pl-12">
          <% %w[Z X C V B N M].each do |k| %>
            <button data-action="pointerdown->kiosk-service-request#nameKey" data-key="<%= k %>"
                    class="btn btn-lg kiosk-keyboard-key h-14 w-14 min-h-0 px-0 text-lg font-bold"><%= k %></button>
          <% end %>
          <button data-action="pointerdown->kiosk-service-request#nameKey" data-key="⌫"
                  class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--delete h-14 w-14 min-h-0 px-0">
            <span class="material-symbols-outlined">backspace</span>
          </button>
        </div>
        <div class="flex gap-2">
          <button data-action="pointerdown->kiosk-service-request#nameKey" data-key=" "
                  class="btn btn-lg kiosk-keyboard-key h-14 min-h-0 w-64 text-sm font-bold tracking-widest uppercase">Space</button>
          <button data-action="pointerdown->kiosk-service-request#nameKey" data-key="'"
                  class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--accent h-14 min-h-0 w-14 text-lg font-bold">'</button>
          <button data-action="pointerdown->kiosk-service-request#nameKey" data-key="-"
                  class="btn btn-lg kiosk-keyboard-key kiosk-keyboard-key--accent h-14 min-h-0 w-14 text-lg font-bold">-</button>
        </div>
      </div>

      <div class="mt-4 flex justify-center">
        <button data-action="pointerdown->kiosk-service-request#nameKey" data-key="→"
                class="btn btn-primary h-[62px] min-h-0 w-[172px] gap-2 rounded-2xl border-0 text-sm font-bold uppercase tracking-widest">
          <span class="material-symbols-outlined">check</span>
          Confirm
        </button>
      </div>

    </div>
  </div>
</div>
