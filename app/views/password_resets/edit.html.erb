<% content_for :title, "Change Password" %>
<section class="mx-auto w-full max-w-md">
  <div class="card bg-base-200 shadow-sm">
    <div class="card-body">
      <h1 class="card-title text-2xl font-bold">Change your password</h1>

      <%= form_with url: password_reset_path(@token),
                    method: :patch,
                    html: {
                      class: "mt-4 space-y-4",
                      data: {
                        controller: "password-requirements",
                        password_requirements_min_length_value: User::MIN_PASSWORD_LENGTH
                      }
                    } do %>
        <div class="form-control">
          <label class="label" for="password"><span class="label-text">New password</span></label>
          <input type="password" name="password" id="password" autofocus autocomplete="new-password" class="input-field w-full"
                 data-password-requirements-target="password"
                 data-action="input->password-requirements#check">
        </div>

        <div class="form-control">
          <label class="label" for="password_confirmation"><span class="label-text">Confirm new password</span></label>
          <input type="password" name="password_confirmation" id="password_confirmation" autocomplete="new-password" class="input-field w-full"
                 data-password-requirements-target="confirmation"
                 data-action="input->password-requirements#check">
          <%= render "registrations/password_requirements" %>
        </div>

        <div class="form-control mt-2">
          <%= submit_tag "Change my password", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
