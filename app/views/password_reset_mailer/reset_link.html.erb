<h1 style="margin:0 0 8px;font-size:28px;font-weight:400;color:<%= MailerTheme::HEADING_TEXT %>;line-height:1.2;">
  Reset your password
</h1>

<p style="margin:0 0 24px;font-size:15px;color:<%= MailerTheme::BODY_TEXT %>;">
  Use this secure link to set a new password for
  <strong style="color:<%= MailerTheme::HEADING_TEXT %>;"><%= @user.email %></strong>.
  Do not share it with anyone.
</p>

<div style="background:<%= MailerTheme::CARD_BG %>;border-radius:12px;padding:28px 24px;margin-bottom:24px;">
  <p style="margin:0 0 18px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;">
    This link expires in <strong style="color:<%= MailerTheme::HEADING_TEXT %>;"><%= @expires_in_minutes %> minutes</strong>
    and can only be used once.
  </p>
  <a href="<%= @reset_url %>"
     style="display:inline-block;background:<%= MailerTheme::PRIMARY %>;color:<%= MailerTheme::PRIMARY_CONTENT %>;text-decoration:none;font-size:15px;font-weight:700;padding:12px 18px;border-radius:8px;">
    Reset password
  </a>
  <%= render "shared/mailer/link_fallback", url: @reset_url %>
</div>

<%= render "shared/mailer/request_details", request_details: @request_details, requested_at: @requested_at %>

<p style="margin:24px 0 0;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;">
  If this was not you, ignore this email and ask an administrator to review your account.
</p>

<p style="margin:16px 0 0;font-size:13px;color:<%= MailerTheme::LIGHT_MUTED %>;">
  RxTerminal will never ask you to share this link or your password.
</p>
