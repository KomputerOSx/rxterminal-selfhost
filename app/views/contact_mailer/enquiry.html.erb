<h1 style="margin:0 0 8px;font-size:28px;font-weight:400;color:<%= MailerTheme::HEADING_TEXT %>;line-height:1.2;">
  New enquiry
</h1>

<p style="margin:0 0 24px;font-size:15px;color:<%= MailerTheme::BODY_TEXT %>;">
  New enquiry from the RxTerminal website.
</p>

<table width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background:<%= MailerTheme::CARD_BG %>;border-radius:12px;overflow:hidden;margin-bottom:24px;">
  <tr>
    <td style="padding:12px 16px;font-size:14px;font-weight:600;color:<%= MailerTheme::BODY_TEXT %>;width:30%;">Name</td>
    <td style="padding:12px 16px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;"><%= @name %></td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-size:14px;font-weight:600;color:<%= MailerTheme::BODY_TEXT %>;">Email</td>
    <td style="padding:12px 16px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;"><%= @email %></td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-size:14px;font-weight:600;color:<%= MailerTheme::BODY_TEXT %>;">Phone</td>
    <td style="padding:12px 16px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;"><%= @phone.present? ? @phone : "-" %></td>
  </tr>
</table>

<p style="margin:0 0 12px;font-size:12px;font-weight:600;color:<%= MailerTheme::MUTED_TEXT %>;letter-spacing:0.08em;text-transform:uppercase;">
  Message
</p>
<div style="background:<%= MailerTheme::CARD_BG %>;border-radius:12px;padding:20px;">
  <p style="margin:0;font-size:15px;color:<%= MailerTheme::BODY_TEXT %>;line-height:1.7;white-space:pre-wrap;"><%= @message %></p>
</div>
