<%= link_to root_path, class: "rx-terminal-brand mt-0.5 inline-flex items-center text-2xl normal-case no-underline hover:opacity-90 #{local_assigns[:class]}" do %>
  <span class="rx">Rx</span>Terminal
<% end %>
