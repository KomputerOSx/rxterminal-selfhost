<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <%= link_to AppConfig.operator_name, root_path, class: "site-footer__logo" %>
      <% if AppConfig.support_email %>
        <p class="site-footer__tagline"><a href="mailto:<%= AppConfig.support_email %>"><%= AppConfig.support_email %></a></p>
      <% end %>
    </div>
    <div class="site-footer__cols">
      <div class="site-footer__col">
        <div class="site-footer__col-title">Legal</div>
        <%= link_to "Terms of Use", legal_terms_path %>
        <%= link_to "Privacy Policy", legal_privacy_policy_path %>
        <%= link_to "Cookies Policy", legal_cookies_path %>
        <%= link_to "Data Protection", legal_gdpr_path %>
      </div>
      <div class="site-footer__col">
        <div class="site-footer__col-title">Staff</div>
        <%= link_to "Log in", login_path %>
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <span>&copy; <%= Date.current.year %> <%= AppConfig.operator_name %></span>
  </div>
</footer>
