<div class="border-b border-warning/40 bg-warning/10">
  <div class="mx-auto flex w-full max-w-7xl items-center gap-3 px-4 py-3 lg:px-8">
    <span class="material-symbols-outlined shrink-0 text-warning">warning</span>
    <p class="text-sm text-base-content">
      Your latest payment failed. Update your card on
      <%= link_to "Billing", billing_path, class: "link link-primary font-medium" %>
      to avoid losing access when Stripe finishes retrying.
    </p>
  </div>
</div>
