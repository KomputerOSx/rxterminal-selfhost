<div class="card mt-6 border border-warning/40 bg-warning/10">
  <div class="card-body flex-row items-center gap-3 py-4">
    <span class="material-symbols-outlined shrink-0 text-warning">upgrade</span>
    <p class="text-sm text-base-content">
      <%= message %>
      <% if current_user&.has_permission?("app.billing.manage", organization: Current.organization) %>
        <%= link_to "View plans", billing_path, class: "link link-primary font-medium" %>
      <% end %>
    </p>
  </div>
</div>
