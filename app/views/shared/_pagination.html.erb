<% if collection.total_pages > 1 %>
  <% link_data = local_assigns[:turbo_frame].present? ? { turbo_frame: local_assigns[:turbo_frame] } : {} %>
  <% page_params = request.query_parameters.except(:page).merge(controller: params[:controller], action: "index") %>

  <nav class="mt-4 flex flex-wrap items-center justify-center gap-4" aria-label="Pagination">
    <div class="join">
      <% if collection.current_page > 1 %>
        <%= link_to url_for(page_params.merge(page: 1)), class: "join-item btn btn-outline btn-sm", data: link_data, aria: { label: "First page" } do %>
          <span class="material-symbols-outlined !text-[18px]">first_page</span>
        <% end %>
      <% else %>
        <button type="button" class="join-item btn btn-outline btn-sm btn-disabled" disabled aria-label="First page">
          <span class="material-symbols-outlined !text-[18px]">first_page</span>
        </button>
      <% end %>

      <% if collection.prev_page %>
        <%= link_to url_for(page_params.merge(page: collection.prev_page)), class: "join-item btn btn-outline btn-sm", data: link_data, aria: { label: "Previous page" } do %>
          <span class="material-symbols-outlined !text-[18px]">chevron_left</span>
        <% end %>
      <% else %>
        <button type="button" class="join-item btn btn-outline btn-sm btn-disabled" disabled aria-label="Previous page">
          <span class="material-symbols-outlined !text-[18px]">chevron_left</span>
        </button>
      <% end %>

      <% page_start = [ collection.current_page - 2, 1 ].max %>
      <% page_end = [ collection.current_page + 2, collection.total_pages ].min %>

      <% if page_start > 1 %>
        <%= link_to "1", url_for(page_params.merge(page: 1)), class: "join-item btn btn-outline btn-sm", data: link_data %>
        <% if page_start > 2 %>
          <button type="button" class="join-item btn btn-outline btn-sm btn-disabled" disabled>...</button>
        <% end %>
      <% end %>

      <% (page_start..page_end).each do |page| %>
        <% if page == collection.current_page %>
          <button type="button" class="join-item btn btn-primary btn-sm" aria-current="page"><%= page %></button>
        <% else %>
          <%= link_to page, url_for(page_params.merge(page: page)), class: "join-item btn btn-outline btn-sm", data: link_data %>
        <% end %>
      <% end %>

      <% if page_end < collection.total_pages %>
        <% if page_end < collection.total_pages - 1 %>
          <button type="button" class="join-item btn btn-outline btn-sm btn-disabled" disabled>...</button>
        <% end %>
        <%= link_to collection.total_pages, url_for(page_params.merge(page: collection.total_pages)), class: "join-item btn btn-outline btn-sm", data: link_data %>
      <% end %>

      <% if collection.next_page %>
        <%= link_to url_for(page_params.merge(page: collection.next_page)), class: "join-item btn btn-outline btn-sm", data: link_data, aria: { label: "Next page" } do %>
          <span class="material-symbols-outlined !text-[18px]">chevron_right</span>
        <% end %>
      <% else %>
        <button type="button" class="join-item btn btn-outline btn-sm btn-disabled" disabled aria-label="Next page">
          <span class="material-symbols-outlined !text-[18px]">chevron_right</span>
        </button>
      <% end %>

      <% if collection.current_page < collection.total_pages %>
        <%= link_to url_for(page_params.merge(page: collection.total_pages)), class: "join-item btn btn-outline btn-sm", data: link_data, aria: { label: "Last page" } do %>
          <span class="material-symbols-outlined !text-[18px]">last_page</span>
        <% end %>
      <% else %>
        <button type="button" class="join-item btn btn-outline btn-sm btn-disabled" disabled aria-label="Last page">
          <span class="material-symbols-outlined !text-[18px]">last_page</span>
        </button>
      <% end %>
    </div>

    <p class="text-sm text-base-content/60">
      Showing <%= collection.offset_value + 1 %>–<%= [ collection.offset_value + collection.limit_value, collection.total_count ].min %>
      of <%= number_with_delimiter(collection.total_count) %>
      <%= local_assigns.fetch(:collection_name) { collection.model_name.human.pluralize.downcase } %>
    </p>
  </nav>
<% end %>
