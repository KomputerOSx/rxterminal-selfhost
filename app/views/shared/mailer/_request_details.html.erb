<% heading = local_assigns.fetch(:heading, "Request details") %>
<p style="margin:0 0 12px;font-size:12px;font-weight:600;color:<%= MailerTheme::MUTED_TEXT %>;letter-spacing:0.08em;text-transform:uppercase;">
  <%= heading %>
</p>
<table width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background:<%= MailerTheme::CARD_BG %>;border-radius:12px;overflow:hidden;">
  <tr>
    <td style="padding:12px 16px;font-size:14px;font-weight:600;color:<%= MailerTheme::BODY_TEXT %>;width:40%;">Time</td>
    <td style="padding:12px 16px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;"><%= requested_at.strftime("%d %b %Y, %H:%M %Z") %></td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-size:14px;font-weight:600;color:<%= MailerTheme::BODY_TEXT %>;">IP address</td>
    <td style="padding:12px 16px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;"><%= request_details[:ip_address].presence || "Unknown" %></td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-size:14px;font-weight:600;color:<%= MailerTheme::BODY_TEXT %>;">Browser / device</td>
    <td style="padding:12px 16px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;word-break:break-all;"><%= request_details[:user_agent].presence || "Unknown" %></td>
  </tr>
</table>
