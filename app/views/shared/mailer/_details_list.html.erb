<% heading = local_assigns[:heading] %>
<% if rows.present? %>
  <% if heading %>
    <p style="margin:0 0 12px;font-size:12px;font-weight:600;color:<%= MailerTheme::MUTED_TEXT %>;letter-spacing:0.08em;text-transform:uppercase;">
      <%= heading %>
    </p>
  <% end %>
  <table width="100%" cellpadding="0" cellspacing="0" border="0"
         style="background:<%= MailerTheme::CARD_BG %>;border:1px solid <%= MailerTheme::CARD_BORDER %>;border-radius:12px;overflow:hidden;margin:0 0 24px;">
    <% rows.each_with_index do |(label, value), index| %>
      <tr>
        <td style="padding:12px 16px;font-size:14px;font-weight:600;color:<%= MailerTheme::BODY_TEXT %>;width:35%;vertical-align:top;<%= "border-top:1px solid #{MailerTheme::CARD_BORDER};" if index.positive? %>">
          <%= label %>
        </td>
        <td style="padding:12px 16px;font-size:14px;color:<%= MailerTheme::BODY_TEXT %>;word-break:break-all;<%= "border-top:1px solid #{MailerTheme::CARD_BORDER};" if index.positive? %>">
          <%= value.presence || "Unknown" %>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>
