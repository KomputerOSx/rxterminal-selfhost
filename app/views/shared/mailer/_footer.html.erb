  <tr>
    <td bgcolor="<%= MailerTheme::HEADER_FOOTER_BG %>"
        style="background-color: <%= MailerTheme::HEADER_FOOTER_BG %>; padding: 24px; text-align: center; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 18px; color: <%= MailerTheme::FOOTER_MUTED %>; border-top: 1px solid <%= MailerTheme::HEADER_FOOTER_BORDER %>;">
      <p style="margin: 0 0 12px;">
        <%= mailer_company_name %> &middot;
        <a href="mailto:<%= mailer_contact_email %>" style="color: <%= MailerTheme::FOOTER_MUTED %>;"><%= mailer_contact_email %></a>
      </p>
      <%= render "shared/mailer/powered_by" %>
    </td>
  </tr>
